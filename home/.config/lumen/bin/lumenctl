#!/usr/bin/env bash
# Lumen's terminal UI. Every action delegates to the documented `lumen` CLI.
set -uo pipefail

title() { gum style --border double --border-foreground 212 --padding '1 3' --margin '1 0' '✦  LUMEN CONTROL CENTER'; }
pause() { gum input --placeholder 'Press Enter to return…' >/dev/null || true; }
run() {
  printf '\n'
  if "$@"; then
    gum style --foreground 42 'Completed successfully.'
  else
    local status=$?
    gum style --foreground 196 "Action failed (exit $status). The output above explains why."
  fi
  pause
}

update_lumen() {
  title
  local repo_dir="$HOME/.local/share/lumen-arch/source"
  mkdir -p "$(dirname "$repo_dir")"
  if [[ -d "$repo_dir/.git" ]]; then
    run git -C "$repo_dir" pull --ff-only
  else
    run git clone https://github.com/rhantschk-cmyk/LumenArch.git "$repo_dir"
  fi
  [[ -d "$repo_dir/.git" ]] || return
  run "$repo_dir/scripts/install-user.sh"
  run sudo pacman -Syu
  command -v yay >/dev/null && run yay -Syu
  if gum confirm 'Apply changed Lumen system files and package requirements now?'; then
    run "$repo_dir/scripts/install-system.sh"
  fi
}

create_webapp() {
  title
  local name url desktop_id desktop_file
  name=$(gum input --prompt 'Web app name: ') || return
  url=$(gum input --prompt 'URL: ' --placeholder 'https://example.org') || return
  [[ -n "$name" && "$url" =~ ^https?://[^[:space:]]+$ ]] || { echo 'Provide a name and an HTTP(S) URL.'; pause; return; }
  desktop_id=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')
  desktop_id=${desktop_id#-}; desktop_id=${desktop_id%-}
  [[ -n "$desktop_id" ]] || { echo 'The name must contain letters or numbers.'; pause; return; }
  desktop_file="$HOME/.local/share/applications/lumen-webapp-$desktop_id.desktop"
  install -d -m 0755 "$HOME/.local/share/applications"
  {
    printf '%s\n' '[Desktop Entry]' 'Type=Application'
    printf 'Name=%s\n' "$name"
    printf 'Exec=firefox --new-window "%s"\n' "$url"
    printf '%s\n' 'Icon=web-browser' 'Categories=Network;WebBrowser;'
  } > "$desktop_file"
  echo "Created $desktop_file"
  pause
}

configure_wifi() {
  title
  command -v nmcli >/dev/null || { echo 'NetworkManager is not installed.'; pause; return; }
  local network ssid security password
  network=$(nmcli -t -f SSID,SECURITY device wifi list --rescan yes | awk -F: 'NF && $1 != "" && !seen[$1]++ { print $1 "\t" $2 }' | gum choose --height 15) || return
  [[ -n "$network" ]] || return
  ssid=${network%%$'\t'*}; security=${network#*$'\t'}
  if [[ -n "$security" && "$security" != '--' ]]; then
    password=$(gum input --password --prompt "Password for $ssid: ") || return
    run nmcli device wifi connect "$ssid" password "$password"
  else
    run nmcli device wifi connect "$ssid"
  fi
}

container_dashboard() {
  title
  if ! id -nG | tr ' ' '\n' | grep -qx docker; then
    echo 'Your user is not in the docker group. Log out and back in after installation.'
    pause
    return
  fi
  if ! systemctl is-active --quiet docker; then
    run sudo systemctl start docker
  fi
  command -v lazydocker >/dev/null || { echo 'LazyDocker is not installed.'; pause; return; }
  lazydocker
  pause
}

curated_apps() {
  title
  local selected packages=()
  selected=$(printf '%s\n' \
    'discord  • community' 'spotify  • music' 'visual-studio-code-bin  • editor' \
    'localsend-bin  • device sharing' 'bitwarden  • passwords' 'steam  • games' \
    'gimp  • images' 'inkscape  • vectors' | gum choose --no-limit --height 10) || return
  [[ -n "$selected" ]] || return
  while IFS= read -r line; do packages+=("${line%%  •*}"); done <<< "$selected"
  gum confirm "Install: ${packages[*]}?" || return
  run lumen install "${packages[@]}"
}

package_menu() {
  while true; do
    title
    local choice package
    choice=$(printf '%s\n' \
      '󰍉  Search official repositories' \
      '󰏗  Search AUR' \
      '󰐆  Install package by name' \
      '󰆍  Enter temporary package shell' \
      '󰆴  Remove installed package' \
      '󰋼  Package information' \
      '󰏖  Curated applications' \
      '󰜺  Back' | gum choose --height 12) || return
    case "$choice" in
      *official*)
        package=$(gum input --prompt 'Filter (empty = all packages): ') || continue
        package=$(lumen search --select "$package") || continue
        gum confirm "Install $package?" && run lumen install "$package"
        ;;
      *AUR*)
        package=$(gum input --prompt 'Filter (empty = all AUR packages): ') || continue
        package=$(lumen search --aur --select "$package") || continue
        gum confirm "Install $package?" && run lumen install "$package"
        ;;
      *Install*) package=$(gum input --prompt 'Package name: ') || continue; [[ -n "$package" ]] && run lumen install "$package" ;;
      *temporary*) package=$(gum input --prompt 'Official package name: ') || continue; [[ -n "$package" ]] && run lumen shell "$package" ;;
      *Remove*) package=$(pacman -Qq | fzf --prompt='Remove package > ') || continue; gum confirm "Remove $package and unused dependencies?" && run lumen remove "$package" ;;
      *information*) package=$(gum input --prompt 'Package name: ') || continue; [[ -n "$package" ]] && run lumen info "$package" ;;
      *Curated*) curated_apps ;;
      *Back*) return ;;
    esac
  done
}

appearance_menu() {
  while true; do
    title
    local choice role desktop
    choice=$(printf '%s\n' \
      '󰖨  Use dark appearance' \
      '󰖔  Use light appearance' \
      '󰅚  Show default applications' \
      '󰒓  Set default application' \
      '󰜺  Back' | gum choose --height 10) || return
    case "$choice" in
      *dark*) run lumen appearance dark ;;
      *light*) run lumen appearance light ;;
      *Show*) run lumen default get browser; run lumen default get editor; run lumen default get file-manager ;;
      *Set*)
        role=$(printf '%s\n' browser editor file-manager | gum choose --prompt 'Role: ') || continue
        desktop=$(gum input --prompt 'Desktop ID:' --placeholder 'firefox.desktop') || continue
        [[ -n "$desktop" ]] && run lumen default set "$role" "$desktop"
        ;;
      *Back*) return ;;
    esac
  done
}

repository_menu() {
  while true; do
    title
    local choice package
    choice=$(printf '%s\n' \
      '󰏗  Repository status' \
      '󰆼  Sync Pacman cache now' \
      '󰈔  Add package or archive' \
      '󰏁  Exclude package from local mirror' \
      '󰏂  Re-include excluded package' \
      '󰏖  List locally available packages' \
      '󰋺  Show local exclusions' \
      '󰆴  Prune old archive versions' \
      '󰅖  Show package holds' \
      '󰜺  Back' | gum choose --height 13) || return
    case "$choice" in
      *status*) run lumen repo status ;;
      *Sync*) run lumen repo sync ;;
      *Add*) package=$(gum input --prompt 'Package name or archive path: ') || continue; [[ -n "$package" ]] && run lumen repo add "$package" ;;
      *Exclude*) package=$(gum input --prompt 'Package to exclude: ') || continue; [[ -n "$package" ]] && run lumen repo exclude "$package" ;;
      *Re-include*) package=$(gum input --prompt 'Package to include again: ') || continue; [[ -n "$package" ]] && run lumen repo unexclude "$package" ;;
      *List*) run lumen repo list ;;
      *exclusions*) run lumen repo exclusions ;;
      *Prune*) gum confirm 'Retain only two versions per package?' && run lumen repo prune ;;
      *holds*) run lumen package list-holds ;;
      *Back*) return ;;
    esac
  done
}

system_menu() {
  while true; do
    title
    local choice service
    choice=$(printf '%s\n' \
      '󰒲  Configure monitors (HyprMon)' \
      '󰆼  Container dashboard (LazyDocker)' \
      '󰖩  Connect to Wi-Fi' \
      '󰋊  Clean package cache' \
      '󰀻  Start or stop a service' \
      '󰩈  System overview' \
      '󰜺  Back' | gum choose --height 12) || return
    case "$choice" in
      *monitors*) hyprmon; pause ;;
      *Container*) container_dashboard ;;
      *Wi-Fi*) configure_wifi ;;
      *Clean*) run sudo paccache -r ;;
      *service*)
        service=$(printf '%s\n' NetworkManager bluetooth docker sddm power-profiles-daemon | gum choose --prompt 'Service: ') || continue
        choice=$(printf '%s\n' status start stop restart enable disable | gum choose --prompt 'Action: ') || continue
        run sudo systemctl "$choice" "$service"
        ;;
      *overview*) fastfetch; echo; df -h /; echo; free -h; pause ;;
      *Back*) return ;;
    esac
  done
}

main() {
  while true; do
    title
    local choice
    choice=$(printf '%s\n' \
      '󰚰  Update Lumen and packages' \
      '󰏖  Packages and applications' \
      '󰖨  Appearance and default apps' \
      '󰏗  Local offline repository' \
      '󰀻  System, network, and services' \
      '󰈙  Create web app shortcut' \
      '󰍎  Lumen health check' \
      '󰜺  Exit' | gum choose --height 14) || exit 0
    case "$choice" in
      *Update*) update_lumen ;;
      *Packages*) package_menu ;;
      *Appearance*) appearance_menu ;;
      *repository*) repository_menu ;;
      *System*) system_menu ;;
      *web\ app*) create_webapp ;;
      *health*) run lumen doctor ;;
      *Exit*) exit 0 ;;
    esac
  done
}

if [[ "${1:-}" == --update ]]; then
  update_lumen
else
  main
fi
