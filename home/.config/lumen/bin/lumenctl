#!/usr/bin/env bash
# Lumen's terminal UI. Every action delegates to the documented `lumen` CLI.
set -uo pipefail

title() { gum style --border double --border-foreground 212 --padding '1 3' --margin '1 0' '✦  LUMEN CONTROL CENTER'; }
pause() { gum input --placeholder 'Press Enter to return…' >/dev/null || true; }
run() {
  printf '\n'
  if "$@"; then
    gum style --foreground 42 'Completed successfully.'
  else
    local status=$?
    gum style --foreground 196 "Action failed (exit $status). The output above explains why."
  fi
  pause
}

update_source() {
  local repo_dir="$1" requested_channel="${2:-}" current_branch channel
  if ! git -C "$repo_dir" diff --quiet || ! git -C "$repo_dir" diff --cached --quiet; then
    echo 'The Lumen source checkout contains uncommitted changes; refusing to overwrite them.' >&2
    echo "Review them in: $repo_dir" >&2
    return 1
  fi
  git -C "$repo_dir" fetch --prune origin || return

  current_branch=$(git -C "$repo_dir" branch --show-current 2>/dev/null || true)
  channel="${requested_channel:-$current_branch}"
  # `main` was the legacy update source. Existing clean installs safely move to
  # the stable channel on their next update instead of being left behind.
  [[ -n "$channel" && "$channel" != main ]] || channel=stable
  case "$channel" in
    stable|unstable) ;;
    *) echo "Unsupported Lumen update channel: $channel" >&2; return 2 ;;
  esac

  if [[ "$current_branch" != "$channel" ]]; then
    if git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$channel"; then
      git -C "$repo_dir" switch "$channel" || return
    else
      git -C "$repo_dir" branch --track "$channel" "origin/$channel" || return
      git -C "$repo_dir" switch "$channel" || return
    fi
  fi
  git -C "$repo_dir" merge --ff-only "origin/$channel"
}

update_channel_menu() {
  title
  local repo_dir="$HOME/.local/share/lumen-arch/source" current_channel choice
  [[ -d "$repo_dir/.git" ]] || { echo 'Install or update Lumen once before selecting an update channel.'; pause; return; }
  current_channel=$(git -C "$repo_dir" branch --show-current 2>/dev/null || true)
  [[ -n "$current_channel" && "$current_channel" != main ]] || current_channel=stable
  echo "Current update channel: $current_channel"
  choice=$(printf '%s\n' \
    'stable  • tested Lumen releases' \
    'unstable  • newest Lumen candidate features' \
    'Back' | gum choose --height 7) || return
  case "$choice" in
    stable*) current_channel=stable ;;
    unstable*) current_channel=unstable ;;
    *) return ;;
  esac
  if update_source "$repo_dir" "$current_channel"; then
    run "$repo_dir/scripts/install-user.sh"
    gum style --foreground 42 "Lumen Control Center and user configuration now follow $current_channel."
    gum confirm 'Apply matching Lumen system files and package requirements now?' && run "$repo_dir/scripts/install-system.sh"
  else
    gum style --foreground 196 'Channel switch stopped before changing Lumen files.'
  fi
  pause
}

update_lumen() {
  title
  local repo_dir="$HOME/.local/share/lumen-arch/source"
  mkdir -p "$(dirname "$repo_dir")"
  if [[ -d "$repo_dir/.git" ]]; then
    if ! update_source "$repo_dir"; then
      gum style --foreground 196 'Update stopped before changing Lumen files.'
      pause
      return
    fi
  else
    if ! git clone https://github.com/rhantschk-cmyk/LumenArch.git "$repo_dir"; then
      gum style --foreground 196 'Could not clone the Lumen source repository.'
      pause
      return
    fi
  fi
  run "$repo_dir/scripts/install-user.sh"
  if gum confirm 'Update installed packages and apply matching Lumen system files now?'; then
    run "$repo_dir/scripts/install-system.sh"
  fi
}

create_webapp() {
  title
  local name url desktop_id desktop_file
  name=$(gum input --prompt 'Web app name: ') || return
  url=$(gum input --prompt 'URL: ' --placeholder 'https://example.org') || return
  [[ -n "$name" && "$url" =~ ^https?://[^[:space:]]+$ ]] || { echo 'Provide a name and an HTTP(S) URL.'; pause; return; }
  desktop_id=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-')
  desktop_id=${desktop_id#-}; desktop_id=${desktop_id%-}
  [[ -n "$desktop_id" ]] || { echo 'The name must contain letters or numbers.'; pause; return; }
  desktop_file="$HOME/.local/share/applications/lumen-webapp-$desktop_id.desktop"
  install -d -m 0755 "$HOME/.local/share/applications"
  {
    printf '%s\n' '[Desktop Entry]' 'Type=Application'
    printf 'Name=%s\n' "$name"
    printf 'Exec=firefox --new-window "%s"\n' "$url"
    printf '%s\n' 'Icon=web-browser' 'Categories=Network;WebBrowser;'
  } > "$desktop_file"
  echo "Created $desktop_file"
  pause
}

configure_wifi() {
  title
  command -v nmcli >/dev/null || { echo 'NetworkManager is not installed.'; pause; return; }
  local network ssid security password
  network=$(nmcli -t -f SSID,SECURITY device wifi list --rescan yes | awk -F: 'NF && $1 != "" && !seen[$1]++ { print $1 "\t" $2 }' | gum choose --height 15) || return
  [[ -n "$network" ]] || return
  ssid=${network%%$'\t'*}; security=${network#*$'\t'}
  if [[ -n "$security" && "$security" != '--' ]]; then
    password=$(gum input --password --prompt "Password for $ssid: ") || return
    run nmcli device wifi connect "$ssid" password "$password"
  else
    run nmcli device wifi connect "$ssid"
  fi
}

container_dashboard() {
  title
  if ! id -nG | tr ' ' '\n' | grep -qx docker; then
    echo 'Your user is not in the docker group. Log out and back in after installation.'
    pause
    return
  fi
  if ! systemctl is-active --quiet docker; then
    run sudo systemctl start docker
  fi
  command -v lazydocker >/dev/null || { echo 'LazyDocker is not installed.'; pause; return; }
  lazydocker
  pause
}

curated_apps() {
  title
  local selected package label source
  selected=$(printf '%s\n' \
    $'discord\tDiscord\tofficial' \
    $'spotify\tSpotify\tAUR' \
    $'visual-studio-code-bin\tVisual Studio Code\tAUR' \
    $'localsend-bin\tLocalSend\tAUR' \
    $'bitwarden\tBitwarden\tofficial' \
    $'steam\tSteam\tmultilib' \
    $'gimp\tGIMP\tofficial' \
    $'inkscape\tInkscape\tofficial' | gum choose --no-limit --height 10) || return
  [[ -n "$selected" ]] || return
  while IFS=$'\t' read -r package label source; do
    [[ -n "$package" ]] || continue
    gum confirm "Install $label ($package, $source)?" || continue
    # Keep each app independent: an unavailable AUR package must not hide a
    # successful official-package install from the same selection.
    run lumen install "$package"
  done <<< "$selected"
}

package_menu() {
  while true; do
    title
    local choice package
    choice=$(printf '%s\n' \
      '󰍉  Search official repositories' \
      '󰏗  Search AUR' \
      '󰐆  Install package by name' \
      '󰆍  Enter temporary package shell' \
      '󰆴  Remove installed package' \
      '󰋼  Package information' \
      '󰏖  Curated applications' \
      '󰜺  Back' | gum choose --height 12) || return
    case "$choice" in
      *official*)
        package=$(gum input --prompt 'Filter (empty = all packages): ') || continue
        package=$(lumen search --select "$package") || continue
        gum confirm "Install $package?" && run lumen install "$package"
        ;;
      *AUR*)
        package=$(gum input --prompt 'Filter (empty = all AUR packages): ') || continue
        package=$(lumen search --aur --select "$package") || continue
        gum confirm "Install $package?" && run lumen install "$package"
        ;;
      *Install*) package=$(gum input --prompt 'Package name: ') || continue; [[ -n "$package" ]] && run lumen install "$package" ;;
      *temporary*) package=$(gum input --prompt 'Official package name: ') || continue; [[ -n "$package" ]] && run lumen shell "$package" ;;
      *Remove*) package=$(pacman -Qq | fzf --prompt='Remove package > ') || continue; gum confirm "Remove $package and unused dependencies?" && run lumen remove "$package" ;;
      *information*) package=$(gum input --prompt 'Package name: ') || continue; [[ -n "$package" ]] && run lumen info "$package" ;;
      *Curated*) curated_apps ;;
      *Back*) return ;;
    esac
  done
}

appearance_menu() {
  while true; do
    title
    local choice role desktop
    choice=$(printf '%s\n' \
      '󰖨  Use dark appearance' \
      '󰖔  Use light appearance' \
      '󰅚  Show default applications' \
      '󰒓  Set default application' \
      '󰜺  Back' | gum choose --height 10) || return
    case "$choice" in
      *dark*) run lumen appearance dark ;;
      *light*) run lumen appearance light ;;
      *Show*) run lumen default get browser; run lumen default get editor; run lumen default get file-manager ;;
      *Set*)
        role=$(printf '%s\n' browser editor file-manager | gum choose --prompt 'Role: ') || continue
        desktop=$(gum input --prompt 'Desktop ID:' --placeholder 'firefox.desktop') || continue
        [[ -n "$desktop" ]] && run lumen default set "$role" "$desktop"
        ;;
      *Back*) return ;;
    esac
  done
}

repository_menu() {
  while true; do
    title
    local choice package destination
    choice=$(printf '%s\n' \
      '󰏗  Repository status' \
      '󰍎  Verify local archive readiness' \
      '󰆼  Sync Pacman cache now' \
      '󰈔  Add package or archive' \
      '󰏁  Exclude package from local mirror' \
      '󰏂  Re-include excluded package' \
      '󰏖  List locally available packages' \
      '󰋺  Show local exclusions' \
      '󰍎  Preview archive cleanup' \
      '󰍎  Preview recovery-kit archive import' \
      '󰆼  Import recovery-kit archives' \
      '󰍎  Verify imported recovery-kit closure' \
      '󰟳  Reconcile local repository metadata' \
      '󰆴  Prune old archive versions' \
      '󰅖  Show package holds' \
      '󰜺  Back' | gum choose --height 16) || return
    case "$choice" in
      *status*) run lumen repo status ;;
      *Verify*) run lumen repo verify ;;
      *Sync*) run lumen repo sync ;;
      *Add*) package=$(gum input --prompt 'Package name or archive path: ') || continue; [[ -n "$package" ]] && run lumen repo add "$package" ;;
      *Exclude*) package=$(gum input --prompt 'Package to exclude: ') || continue; [[ -n "$package" ]] && run lumen repo exclude "$package" ;;
      *Re-include*) package=$(gum input --prompt 'Package to include again: ') || continue; [[ -n "$package" ]] && run lumen repo unexclude "$package" ;;
      *List*) run lumen repo list ;;
      *exclusions*) run lumen repo exclusions ;;
      *Preview\ recovery-kit*)
        destination=$(gum input --prompt 'Mounted absolute recovery-kit directory (read-only preview): ') || continue
        [[ -n "$destination" ]] && run lumen repo import-kit --preview "$destination"
        ;;
      *Import\ recovery-kit*)
        destination=$(gum input --prompt 'Mounted absolute recovery-kit directory (verified archives only): ') || continue
        if [[ -n "$destination" ]] && lumen repo import-kit --preview "$destination"; then
          gum confirm 'Import only missing verified archives and rebuild the local offline repository? Installed packages and the kit remain unchanged.' && run lumen repo import-kit "$destination" --yes
        fi
        ;;
      *Verify\ imported\ recovery-kit*)
        destination=$(gum input --prompt 'Still-mounted absolute recovery-kit directory (read-only completion check): ') || continue
        [[ -n "$destination" ]] && run lumen repo verify-import "$destination"
        ;;
      *Reconcile\ local\ repository*)
        if ! lumen repo verify; then
          gum confirm 'Rebuild only local repository database, Pacman source and sync metadata from the existing archives? Archives, installed packages and recovery kits remain unchanged.' && run lumen repo reconcile --yes
        else
          echo 'Local repository metadata is already ready; reconciliation is unnecessary.'
          pause
        fi
        ;;
      *Preview*) run lumen repo prune --preview ;;
      *Prune*) gum confirm 'Retain only two versions per package?' && run lumen repo prune ;;
      *holds*) run lumen package list-holds ;;
      *Back*) return ;;
    esac
  done
}

focus_menu() {
  while true; do
    title
    local choice minutes label
    choice=$(printf '%s\n' \
      '󰔟  Start a focus session' \
      '󰥔  Show focus status' \
      '󰅖  Stop focus session' \
      '󰜺  Back' | gum choose --height 8) || return
    case "$choice" in
      *Start*)
        minutes=$(gum input --prompt 'Minutes: ' --value '25') || continue
        label=$(gum input --prompt 'What are you focusing on? ' --value 'Focus session') || continue
        [[ -n "$minutes" ]] && run lumen focus start "$minutes" "$label"
        ;;
      *status*) run lumen focus status ;;
      *Stop*) run lumen focus stop ;;
      *Back*) return ;;
    esac
  done
}

project_menu() {
  while true; do
    title
    local choice directory name description project version label destination
    choice=$(printf '%s\n' \
      '󰏗  List registered projects' \
      '󰈙  Initialise project in a directory' \
      '󰆍  Open project shell' \
      '󰑓  Run project command' \
      '󰅩  Compile project' \
      '󰆴  Save project snapshot' \
      '󰋚  List project versions' \
      '󰍎  Rehearse saved snapshot offline' \
      '󰆈  Export offline recovery kit' \
      '󰍎  Verify offline recovery kit' \
      '󰍎  Rehearse recovery kit offline' \
      '󰀼  Restore recovery-kit snapshot' \
      '󰜺  Back' | gum choose --height 13) || return
    case "$choice" in
      *List\ registered*) run lumen project list ;;
      *Initialise*)
        directory=$(gum input --prompt 'Directory: ' --value "$PWD") || continue
        name=$(gum input --prompt 'Project name: ') || continue
        description=$(gum input --prompt 'Description: ') || continue
        [[ -n "$name" && -n "$description" ]] && run lumen project init "$directory" --name "$name" --description "$description"
        ;;
      *shell*) project=$(gum input --prompt 'Project name (empty = current directory): ') || continue; run lumen project shell $project ;;
      *Run*) project=$(gum input --prompt 'Project name (empty = current directory): ') || continue; run lumen project run $project ;;
      *Compile*) project=$(gum input --prompt 'Project name (empty = current directory): ') || continue; run lumen project compile $project ;;
      *Save*)
        project=$(gum input --prompt 'Project name (empty = current directory): ') || continue
        label=$(gum input --prompt 'Snapshot label (optional): ') || continue
        if [[ -n "$label" ]]; then run lumen project save $project --label "$label"; else run lumen project save $project; fi
        ;;
      *versions*) project=$(gum input --prompt 'Project name (empty = current directory): ') || continue; run lumen project versions $project ;;
      *Rehearse*)
        project=$(gum input --prompt 'Registered project name: ') || continue
        version=$(gum input --prompt 'Saved version (for example v000001): ') || continue
        [[ -n "$project" && -n "$version" ]] && run lumen project doctor "$project" --version "$version"
        ;;
      *Export*)
        project=$(gum input --prompt 'Registered project name: ') || continue
        version=$(gum input --prompt 'Saved version (for example v000001): ') || continue
        destination=$(gum input --prompt 'New absolute kit directory (must be empty): ') || continue
        [[ -n "$project" && -n "$version" && -n "$destination" ]] && run lumen project export "$project" --version "$version" --to "$destination"
        ;;
      *Verify*)
        destination=$(gum input --prompt 'Mounted absolute recovery-kit directory: ') || continue
        [[ -n "$destination" ]] && run lumen project verify-kit "$destination"
        ;;
      *Rehearse\ recovery\ kit*)
        destination=$(gum input --prompt 'Mounted absolute recovery-kit directory (requires sudo and temporary /run space): ') || continue
        [[ -n "$destination" ]] && run lumen project rehearse-kit "$destination"
        ;;
      *Restore\ recovery-kit*)
        directory=$(gum input --prompt 'Mounted absolute recovery-kit directory (will remain unchanged): ') || continue
        destination=$(gum input --prompt 'Absolute empty destination directory (will be written): ') || continue
        [[ -n "$directory" && -n "$destination" ]] && run lumen project restore-kit "$directory" --to "$destination" --yes
        ;;
      *Back*) return ;;
    esac
  done
}

theme_menu() {
  while true; do
    title
    local choice name bg surface fg accent success warning danger
    choice=$(printf '%s\n' \
      '󰏘  Apply Lumen lavender' \
      '󰏘  Apply Ocean blue' \
      '󰏘  Create a custom palette' \
      '󰋚  Show active palette' \
      '󰜺  Back' | gum choose --height 10) || return
    case "$choice" in
      *lavender*) run lumen theme apply lumen ;;
      *Ocean*) run lumen theme apply ocean ;;
      *custom*)
        name=$(gum input --prompt 'Theme name: ' --value 'My Lumen Theme') || continue
        bg=$(gum input --prompt 'Background hex: ' --value '#1e1e2e') || continue
        surface=$(gum input --prompt 'Surface hex: ' --value '#313244') || continue
        fg=$(gum input --prompt 'Foreground hex: ' --value '#cdd6f4') || continue
        accent=$(gum input --prompt 'Accent hex: ' --value '#cba6f7') || continue
        success=$(gum input --prompt 'Success hex: ' --value '#a6e3a1') || continue
        warning=$(gum input --prompt 'Warning hex: ' --value '#f9e2af') || continue
        danger=$(gum input --prompt 'Danger hex: ' --value '#f38ba8') || continue
        run lumen theme custom "$name" "$bg" "$surface" "$fg" "$accent" "$success" "$warning" "$danger"
        ;;
      *active*) run lumen theme status ;;
      *Back*) return ;;
    esac
  done
}

network_guard_menu() {
  while true; do
    title
    local choice minutes
    choice=$(printf '%s\n' \
      '󰖩  Enable lock-idle isolation' \
      '󰖨  Disable Network Guard' \
      '󰌵  Pause isolation temporarily' \
      '󰋚  Show Network Guard status' \
      '󰜺  Back' | gum choose --height 10) || return
    case "$choice" in
      *Enable*) run lumen network guard enable ;;
      *Disable*) run lumen network guard disable ;;
      *Pause*) minutes=$(gum input --prompt 'Pause minutes: ' --value '60') || continue; run lumen network guard pause "$minutes" ;;
      *status*) run lumen network guard status ;;
      *Back*) return ;;
    esac
  done
}

system_menu() {
  while true; do
    title
    local choice service
    choice=$(printf '%s\n' \
      '󰒲  Configure monitors (HyprMon)' \
      '󰆼  Container dashboard (LazyDocker)' \
      '󰖩  Connect to Wi-Fi' \
      '󰋊  Clean package cache' \
      '󰀻  Start or stop a service' \
      '󰩈  System overview' \
      '󰜺  Back' | gum choose --height 12) || return
    case "$choice" in
      *monitors*) hyprmon; pause ;;
      *Container*) container_dashboard ;;
      *Wi-Fi*) configure_wifi ;;
      *Clean*) run sudo paccache -r ;;
      *service*)
        service=$(printf '%s\n' NetworkManager bluetooth docker sddm power-profiles-daemon | gum choose --prompt 'Service: ') || continue
        choice=$(printf '%s\n' status start stop restart enable disable | gum choose --prompt 'Action: ') || continue
        run sudo systemctl "$choice" "$service"
        ;;
      *overview*) fastfetch; echo; df -h /; echo; free -h; pause ;;
      *Back*) return ;;
    esac
  done
}

apps_menu() {
  while true; do
    title
    local choice
    choice=$(printf '%s\n' \
      '󰏖  Packages and applications' \
      '󰈙  Create web app shortcut' \
      '󰜺  Back' | gum choose --height 8) || return
    case "$choice" in
      *Packages*) package_menu ;;
      *web\ app*) create_webapp ;;
      *Back*) return ;;
    esac
  done
}

media_pipeline_menu() {
  title
  if ! command -v lumen-media >/dev/null; then
    echo 'Lumen Media Pipeline is not installed. Install the optional lumen-media CLI to enable this workflow.'
    pause
    return
  fi
  local choice project action target token
  choice=$(printf '%s\n' \
    '󰝚  Initialize media project' \
    '󰋚  Show media project status' \
    '󰋚  Run configured project action' \
    '󰕒  Sync exports with Lumen LAN Drop' \
    '󰜺  Back' | gum choose --height 10) || return
  case "$choice" in
    *Initialize*)
      project=$(gum input --prompt 'Media project directory: ' --placeholder "$HOME/Media/my-project") || return
      [[ -n "$project" ]] && run lumen-media init "$project"
      ;;
    *status*)
      project=$(gum input --prompt 'Media project directory: ') || return
      [[ -n "$project" ]] && run lumen-media status "$project"
      ;;
    *configured*)
      project=$(gum input --prompt 'Media project directory: ') || return
      action=$(gum input --prompt 'Configured action name: ') || return
      [[ -n "$project" && -n "$action" ]] && run lumen-media action run "$action" "$project"
      ;;
    *Sync*)
      if ! command -v lumen-landrop >/dev/null; then
        echo 'Lumen LAN Drop is not installed; export sync remains optional.'
        pause
        return
      fi
      project=$(gum input --prompt 'Media project directory: ') || return
      target=$(gum input --prompt 'LAN Drop receiver URL: ' --placeholder 'http://device:8765') || return
      token=$(gum input --password --prompt 'One-time receiver token: ') || return
      [[ -n "$project" && -n "$target" && -n "$token" ]] && run lumen-media sync-exports "$project" --to "$target" --token "$token"
      ;;
    *) return ;;
  esac
}

main() {
  while true; do
    title
    local choice
    choice=$(printf '%s\n' \
      '󰚰  Update Lumen and packages' \
      '󰏁  Lumen update channel' \
      '󰖨  Appearance and default apps' \
      '󰏘  Theme Studio' \
      '󰏖  Apps and packages' \
      '󰝚  Media projects and LAN Drop' \
      '󰔟  Focus sessions' \
      '󰈙  Projects and snapshots' \
      '󰏗  Local offline repository' \
      '󰖩  Network privacy guard' \
      '󰀻  System and network' \
      '󰍎  Lumen health check' \
      '󰜺  Exit' | gum choose --height 14) || exit 0
    case "$choice" in
      *Update\ Lumen*) update_lumen ;;
      *update\ channel*) update_channel_menu ;;
      *Appearance*) appearance_menu ;;
      *Theme\ Studio*) theme_menu ;;
      *Apps*) apps_menu ;;
      *Media*) media_pipeline_menu ;;
      *Focus*) focus_menu ;;
      *Projects*) project_menu ;;
      *repository*) repository_menu ;;
      *privacy\ guard*) network_guard_menu ;;
      *System*) system_menu ;;
      *health*) run lumen doctor ;;
      *Exit*) exit 0 ;;
    esac
  done
}

if [[ "${1:-}" == --update ]]; then
  update_lumen
else
  main
fi
