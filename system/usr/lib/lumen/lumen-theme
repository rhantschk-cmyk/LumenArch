#!/usr/bin/env bash
# Local, user-owned palette generator for Lumen applications.
set -Eeuo pipefail

root="${XDG_CONFIG_HOME:-$HOME/.config}/lumen"
config="$root/theme.conf"
valid_hex() { [[ "$1" =~ ^#[0-9A-Fa-f]{6}$ ]]; }
write_theme() {
  local name="$1" bg="$2" surface="$3" fg="$4" accent="$5" success="$6" warning="$7" danger="$8"
  for color in "$bg" "$surface" "$fg" "$accent" "$success" "$warning" "$danger"; do valid_hex "$color" || { echo "Invalid hex color: $color" >&2; exit 2; }; done
  install -d -m 0700 "$root" "$HOME/.config/alacritty" "$HOME/.config/fastfetch" "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0" "$HOME/.config/nvim/lua/config" "$HOME/.config/Code/User" "$HOME/.config/quickshell/lumen/qs/Commons"
  printf 'name=%q\nbackground=%q\nsurface=%q\nforeground=%q\naccent=%q\nsuccess=%q\nwarning=%q\ndanger=%q\n' "$name" "$bg" "$surface" "$fg" "$accent" "$success" "$warning" "$danger" > "$config"
  cat > "$HOME/.config/alacritty/lumen-theme.toml" <<EOF
[colors.primary]
background = "$bg"
foreground = "$fg"
[colors.normal]
blue = "$accent"
cyan = "$accent"
green = "$success"
magenta = "$accent"
red = "$danger"
yellow = "$warning"
EOF
  cat > "$HOME/.config/fastfetch/config.jsonc" <<EOF
{"logo":{"type":"small","padding":{"top":1,"left":2}},"display":{"separator":"    "},"modules":[{"type":"title","keyWidth":14},{"type":"separator"},{"type":"custom","key":"󰣇 OS","format":"Lumen Arch"},{"type":"kernel","key":"󰌽 Kernel"},{"type":"packages","key":"󰏖 Packages"},{"type":"shell","key":"󰆍 Shell"},{"type":"wm","key":" Compositor"},{"type":"terminal","key":" Terminal"},{"type":"cpu","key":"󰻠 CPU"},{"type":"gpu","key":"󰍛 GPU"},{"type":"memory","key":"󰑭 Memory"},{"type":"break"},{"type":"colors","symbol":"circle"}]}
EOF
  cat > "$HOME/.config/gtk-3.0/gtk.css" <<EOF
/* Generated by Lumen Theme Studio ($name). */
window, dialog, popover { background-color: $bg; color: $fg; }
button, entry { background-color: $surface; color: $fg; border-color: $accent; }
selection { background-color: $accent; color: $bg; }
EOF
  cp "$HOME/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-4.0/gtk.css"
  cat > "$HOME/.config/nvim/lua/config/lumen_theme.lua" <<EOF
local c={bg="$bg",surface="$surface",fg="$fg",accent="$accent",success="$success",warning="$warning",danger="$danger"}
local function apply() vim.api.nvim_set_hl(0,"Normal",{fg=c.fg,bg=c.bg}); vim.api.nvim_set_hl(0,"NormalFloat",{fg=c.fg,bg=c.surface}); vim.api.nvim_set_hl(0,"Visual",{bg=c.accent,fg=c.bg}); vim.api.nvim_set_hl(0,"CursorLine",{bg=c.surface}); vim.api.nvim_set_hl(0,"StatusLine",{fg=c.fg,bg=c.surface}); vim.api.nvim_set_hl(0,"LineNr",{fg=c.accent}); end
apply(); vim.api.nvim_create_autocmd("ColorScheme",{callback=apply})
EOF
  cat > "$HOME/.config/quickshell/lumen/qs/Commons/Color.qml" <<EOF
pragma Singleton
import QtQuick
QtObject { readonly property color accent: "$accent"; readonly property color foreground: "$fg"; readonly property color background: "$bg"; readonly property color muted: "$surface"; readonly property color urgent: "$danger" }
EOF
  if [[ -f "$HOME/.config/Code/User/settings.json" ]]; then cp -n "$HOME/.config/Code/User/settings.json" "$HOME/.config/Code/User/settings.json.lumen-backup" || true; fi
  python3 - "$HOME/.config/Code/User/settings.json" "$bg" "$fg" "$accent" "$surface" <<'PY'
import json, pathlib, sys
p=pathlib.Path(sys.argv[1]); data={}
try: data=json.loads(p.read_text()) if p.exists() else {}
except json.JSONDecodeError: data={}
data['workbench.colorCustomizations']={'editor.background':sys.argv[2],'editor.foreground':sys.argv[3],'activityBar.background':sys.argv[4],'statusBar.background':sys.argv[5],'focusBorder':sys.argv[4]}
p.write_text(json.dumps(data,indent=2)+'\n')
PY
  if [[ -f "$HOME/.mozilla/firefox/profiles.ini" ]]; then
    while IFS= read -r profile; do
      dir="$HOME/.mozilla/firefox/$profile"; mkdir -p "$dir/chrome"
      printf 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);\n' >> "$dir/user.js"
      cat > "$dir/chrome/userChrome.css" <<EOF
:root { --lumen-bg: $bg; --lumen-surface: $surface; --lumen-fg: $fg; --lumen-accent: $accent; }
#navigator-toolbox, #TabsToolbar { background: var(--lumen-bg) !important; color: var(--lumen-fg) !important; }
.tabbrowser-tab[selected] .tab-background { background: var(--lumen-surface) !important; border-top: 2px solid var(--lumen-accent) !important; }
EOF
    done < <(awk -F= '/^Path=/{print $2}' "$HOME/.mozilla/firefox/profiles.ini")
  fi
  command -v hyprctl >/dev/null && hyprctl reload || true
  echo "Applied Lumen theme: $name"
}
case "${1:-status}" in
  apply) case "${2:-lumen}" in lumen) write_theme Lumen '#1e1e2e' '#313244' '#cdd6f4' '#cba6f7' '#a6e3a1' '#f9e2af' '#f38ba8' ;; ocean) write_theme Ocean '#0b1020' '#16213a' '#d9e7ff' '#38bdf8' '#34d399' '#fbbf24' '#fb7185' ;; *) echo 'Available themes: lumen, ocean' >&2; exit 2;; esac ;;
  custom) shift; [[ $# -eq 8 ]] || { echo 'Usage: lumen theme custom <name> <background> <surface> <foreground> <accent> <success> <warning> <danger>' >&2; exit 2; }; write_theme "$@" ;;
  status) [[ -f "$config" ]] && cat "$config" || echo 'No Lumen theme applied yet.' ;;
  *) echo 'Usage: lumen theme <apply|custom|status>' >&2; exit 2 ;;
esac
