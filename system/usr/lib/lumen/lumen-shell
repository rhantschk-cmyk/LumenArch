#!/usr/bin/env bash
# Build and enter an ephemeral package environment without modifying the host.
set -Eeuo pipefail

config_file=/etc/lumen/repo.conf
repo_sync=/usr/lib/lumen/lumen-repo-sync
shell_root=''
temporary_config=''
temporary_db=''
workspace_dir=''
shell_uid=''
shell_gid=''

if [[ -r "$config_file" ]]; then
  source "$config_file"
else
  REPO_DIR=/var/lib/lumen/repo
fi
: "${REPO_NAME:=lumen-local}"

usage() {
  cat <<'EOF'
Usage: lumen-shell <official-package> [--dir <directory>]

Create a temporary, isolated command-line environment containing an official
Arch package. Host packages are never modified. On exit the environment is
deleted; downloaded package archives remain in Lumen's local repository.

--dir DIRECTORY mounts a host directory read-write at /workspace and starts
the shell there. Changes to files below /workspace are changes to that host
directory. The shell runs with the invoking user's UID and GID, so edited
files retain normal ownership.

If the package closure is already local, no network is used. Otherwise Lumen
downloads the closure into its local repository before creating the shell.
EOF
}

valid_package_name() {
  [[ "$1" =~ ^[A-Za-z0-9@._+:-]+$ ]]
}

cleanup() {
  if [[ -n "$shell_root" && "$shell_root" == /run/lumen-shell/root.* && -d "$shell_root" ]]; then
    rm -rf -- "$shell_root"
  fi
  if [[ -n "$temporary_config" && -f "$temporary_config" ]]; then
    rm -f -- "$temporary_config"
  fi
  if [[ -n "$temporary_db" && "$temporary_db" == /var/tmp/lumen-shell-db.* && -d "$temporary_db" ]]; then
    rm -rf -- "$temporary_db"
  fi
}
trap cleanup EXIT INT TERM

require_root() {
  [[ $EUID -eq 0 ]] || { echo 'lumen-shell must be invoked through sudo.' >&2; exit 1; }
}

write_local_config() {
  temporary_config=$(mktemp /var/tmp/lumen-shell-pacman.XXXXXX)
  cat > "$temporary_config" <<EOF
[options]
Architecture = auto
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional

[$REPO_NAME]
SigLevel = Optional TrustAll
Server = file://$REPO_DIR
EOF
}

download_closure() {
  echo 'The local repository is missing part of this package closure.'
  echo 'Downloading the required official archives into the Lumen repository…'
  temporary_db=$(mktemp -d /var/tmp/lumen-shell-db.XXXXXX)
  mkdir -p "$REPO_DIR"
  pacman -Syyw --noconfirm --dbpath "$temporary_db" --cachedir "$REPO_DIR" \
    bash coreutils vim "$package"
  rm -rf -- "$temporary_db"
  temporary_db=''
  "$repo_sync" sync
}

bootstrap_environment() {
  # /var/tmp is often mounted noexec. A container root stored there produces
  # the misleading "bash: Permission denied" even though bash itself is 0755.
  # /run is an executable, boot-local tmpfs and is ideal for this disposable
  # root filesystem.
  install -d -m 0700 /run/lumen-shell
  shell_root=$(mktemp -d /run/lumen-shell/root.XXXXXX)
  if pacstrap -G -C "$temporary_config" "$shell_root" bash coreutils vim "$package"; then
    return
  fi

  rm -rf -- "$shell_root"
  shell_root=''
  download_closure
  shell_root=$(mktemp -d /run/lumen-shell/root.XXXXXX)
  pacstrap -G -C "$temporary_config" "$shell_root" bash coreutils vim "$package"
}

prepare_workspace_user() {
  [[ -n "$workspace_dir" ]] || return
  local invoking_user="${SUDO_USER:-}"
  [[ -n "$invoking_user" && "$invoking_user" != root ]] || {
    echo 'A workspace shell must be launched through sudo by a regular user.' >&2
    exit 1
  }
  shell_uid=$(id -u "$invoking_user")
  shell_gid=$(id -g "$invoking_user")
  install -d -m 0755 "$shell_root/home/lumen"
  install -d -m 0755 "$shell_root/workspace"
  chown "$shell_uid:$shell_gid" "$shell_root/home/lumen"
  printf 'lumen:x:%s:%s:Lumen shell user:/home/lumen:/bin/bash\n' "$shell_uid" "$shell_gid" >> "$shell_root/etc/passwd"
  printf 'lumen:x:%s:\n' "$shell_gid" >> "$shell_root/etc/group"
}

case "${1:-}" in
  -h|--help|help) usage; exit 0 ;;
esac

require_root
[[ $# -ge 1 ]] || { usage >&2; exit 2; }
package="$1"
shift
while (($#)); do
  case "$1" in
    --dir)
      [[ $# -eq 2 && -z "$workspace_dir" ]] || { usage >&2; exit 2; }
      workspace_dir=$(realpath -e -- "$2")
      [[ -d "$workspace_dir" ]] || { echo "Not a directory: $2" >&2; exit 2; }
      shift 2
      ;;
    *) usage >&2; exit 2 ;;
  esac
done
valid_package_name "$package" || { echo "Invalid package name: $package" >&2; exit 2; }
command -v pacstrap >/dev/null || { echo 'pacstrap is unavailable; install arch-install-scripts.' >&2; exit 1; }
command -v systemd-nspawn >/dev/null || { echo 'systemd-nspawn is unavailable.' >&2; exit 1; }
[[ -x "$repo_sync" ]] || { echo 'Lumen repository helper is unavailable.' >&2; exit 1; }

write_local_config
bootstrap_environment
prepare_workspace_user
{
  printf "PS1='(lumen:%s) " "$package"
  cat <<'EOF'
\u@\h:\w\$ '
EOF
} > "$shell_root/root/.bashrc"

echo "Entering temporary Lumen shell for: $package"
echo 'Run exit to remove the environment. Host packages are unchanged.'
if [[ -n "$workspace_dir" ]]; then
  echo "Host directory mounted at /workspace: $workspace_dir"
  systemd-nspawn --directory="$shell_root" --register=no --user="$shell_uid" \
    --bind="$workspace_dir:/workspace" --setenv="TERM=${TERM:-xterm-256color}" \
    /usr/bin/bash -c 'cd /workspace && exec /usr/bin/bash -l'
else
  systemd-nspawn --directory="$shell_root" --register=no --setenv="TERM=${TERM:-xterm-256color}" /usr/bin/bash -l
fi
