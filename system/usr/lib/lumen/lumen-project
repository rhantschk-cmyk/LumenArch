#!/usr/bin/env python3
"""Root-backed project registry, reproducible environments, and snapshots."""
import hashlib
import errno
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError as exc:
    raise SystemExit("Python 3.11 or newer is required for Lumen projects.") from exc

ROOT = Path(os.environ.get("LUMEN_PROJECT_ROOT", "/var/lib/lumen/projects"))
INDEX = ROOT / "index.json"
REPO = Path(os.environ.get("LUMEN_REPO_DIR", "/var/lib/lumen/repo"))
SHELL = os.environ.get("LUMEN_SHELL_HELPER", "/usr/lib/lumen/lumen-shell")
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
PACKAGE = re.compile(r"^[A-Za-z0-9@._+:-]+$")


def die(message, code=1):
    print(f"lumen project: {message}", file=sys.stderr)
    raise SystemExit(code)


def require_root():
    if os.geteuid() != 0:
        die("this command must be run through sudo")


def caller_ids():
    user = os.environ.get("SUDO_USER")
    uid = os.environ.get("SUDO_UID")
    gid = os.environ.get("SUDO_GID")
    if not user or not uid or not gid or user == "root":
        die("run `lumen project …` as a regular user, not directly as root")
    return user, int(uid), int(gid)


def load_index():
    if not INDEX.exists():
        return {"schema": 1, "projects": {}}
    try:
        data = json.loads(INDEX.read_text())
        if data.get("schema") != 1 or not isinstance(data.get("projects"), dict):
            raise ValueError
        return data
    except (OSError, ValueError, json.JSONDecodeError):
        die("project registry is invalid: /var/lib/lumen/projects/index.json")


def atomic_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def project_id(name, workspace):
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "project"
    digest = hashlib.sha256(str(workspace).encode()).hexdigest()[:10]
    return f"{slug}-{digest}"


def config_path(directory):
    return directory / "project.lumen"


def parse_config(directory):
    directory = directory.resolve()
    path = config_path(directory)
    if not path.is_file():
        die(f"missing project.lumen in {directory}")
    try:
        raw = tomllib.loads(path.read_text(encoding="utf-8"))
        init = raw["Init"]
        environment = raw["Environment"]
        versions = raw["Versions"]
        name = init["Name"]
        description = init["Description"]
        packages = environment["Packages"]
        workspace_setting = environment["Workspace"]
        execute = environment["Exec"]
        compile_command = environment["Compile"]
        mode = environment.get("Mode", "shell")
        versions_path = versions.get("Path", ".lumen/versions")
        compile_before = versions.get("CompileBeforeSaving", True)
        excludes = versions.get("Exclude", [".git", "target", "node_modules", ".lumen"])
    except tomllib.TOMLDecodeError as exc:
        hint = " Close the list with `]`, for example: Packages = [\"bash\", \"python\"]." if "Unclosed array" in str(exc) else ""
        die(f"invalid project.lumen at {path}: {exc}.{hint}")
    except (KeyError, TypeError) as exc:
        die(f"invalid project.lumen at {path}: {exc}")
    if not all(isinstance(value, str) for value in (name, description, workspace_setting, execute, compile_command, mode, versions_path)):
        die("project.lumen text fields must be strings")
    if not NAME.fullmatch(name):
        die("Init.Name must contain 1-64 letters, digits, dot, underscore, or hyphen")
    if not isinstance(packages, list) or not packages or not all(isinstance(item, str) and PACKAGE.fullmatch(item) for item in packages):
        die("Environment.Packages must be a non-empty list of official package names")
    if mode not in ("shell", "host"):
        die("Environment.Mode must be shell or host")
    if not isinstance(compile_before, bool) or not isinstance(excludes, list) or not all(isinstance(item, str) for item in excludes):
        die("Versions settings have invalid types")
    workspace = (directory / workspace_setting).resolve()
    if workspace != directory and directory not in workspace.parents:
        die("Environment.Workspace must stay inside the project directory")
    if not workspace.is_dir():
        die(f"workspace does not exist: {workspace}")
    for excluded in excludes:
        if Path(excluded).is_absolute() or ".." in Path(excluded).parts:
            die("Versions.Exclude entries must be relative and may not contain ..")
    return {
        "directory": directory, "config": path, "name": name, "description": description,
        "packages": list(dict.fromkeys(packages)), "workspace": workspace, "exec": execute,
        "compile": compile_command, "mode": mode, "versions_path": versions_path,
        "compile_before": compile_before, "excludes": excludes,
    }


def find_project_directory(start):
    current = Path(start).resolve()
    if current.is_file():
        current = current.parent
    for candidate in (current, *current.parents):
        if config_path(candidate).is_file():
            return candidate
    die("no project.lumen found in this directory or its parents")


def project_record(selector=None, directory=None):
    index = load_index()
    if directory is not None:
        directory = find_project_directory(directory)
        matches = [(ident, record) for ident, record in index["projects"].items() if Path(record["path"]) == directory]
        if matches:
            return matches[0][0], matches[0][1], index
        cfg = parse_config(directory)
        ident = project_id(cfg["name"], directory)
        return ident, {"name": cfg["name"], "path": str(directory), "description": cfg["description"]}, index
    if not selector:
        return project_record(directory=Path.cwd())
    for ident, record in index["projects"].items():
        if selector in (ident, record.get("name")):
            return ident, record, index
    die(f"unknown project: {selector}")


def register(directory):
    cfg = parse_config(directory)
    ident = project_id(cfg["name"], cfg["directory"])
    index = load_index()
    index["projects"][ident] = {"name": cfg["name"], "description": cfg["description"], "path": str(cfg["directory"])}
    atomic_json(INDEX, index)
    base = ROOT / ident
    for child in ("snapshots", "locks", "manifests"):
        (base / child).mkdir(parents=True, exist_ok=True)
    atomic_json(base / "metadata.json", {"id": ident, **index["projects"][ident]})
    return ident, cfg


def run(command, check=True, **kwargs):
    return subprocess.run(command, check=check, text=True, **kwargs)


def lock_path(ident, version="current"):
    return ROOT / ident / "locks" / f"{version}.json"


def enrich_lock(raw_lock):
    wanted = {}
    for line in raw_lock.read_text().splitlines():
        pieces = line.split(maxsplit=1)
        if len(pieces) == 2:
            wanted[pieces[0]] = pieces[1]
    archives = {}
    for archive in REPO.glob("*.pkg.tar.*"):
        if archive.name.endswith(".sig"):
            continue
        result = subprocess.run(["pacman", "-Qp", str(archive)], text=True, capture_output=True, check=False)
        pieces = result.stdout.split()
        if len(pieces) >= 2 and wanted.get(pieces[0]) == pieces[1]:
            archives[pieces[0]] = {"version": pieces[1], "archive": archive.name,
                                   "sha256": hashlib.file_digest(archive.open("rb"), "sha256").hexdigest()}
    missing = sorted(set(wanted) - set(archives))
    if missing:
        die("local repository is missing resolved archives: " + ", ".join(missing[:8]))
    return {"schema": 1, "packages": [{"name": name, **archives[name]} for name in sorted(archives)]}


def prepare_lock(ident, cfg, version="current"):
    destination = lock_path(ident, version)
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(prefix="lumen-project-lock.", delete=False) as handle:
        raw = Path(handle.name)
    try:
        command = [SHELL]
        for package in cfg["packages"]:
            command += ["--package", package]
        command += ["--dir", str(cfg["workspace"]), "--prepare", "--lock-file", str(raw)]
        run(command)
        atomic_json(destination, enrich_lock(raw))
    finally:
        raw.unlink(missing_ok=True)
    return destination


def load_version_lock(ident, version):
    path = lock_path(ident, version)
    if not path.is_file() or path.is_symlink():
        die(f"package lock not found for snapshot: {version}")
    try:
        packages = json.loads(path.read_text()).get("packages", [])
    except json.JSONDecodeError:
        die(f"invalid package lock for snapshot: {version}")
    if not packages:
        die(f"empty package lock for snapshot: {version}")
    return packages


def saved_snapshot_manifest_from_path(path, label):
    if not path.is_file() or path.is_symlink():
        die(f"saved manifest not found for {label}")
    try:
        raw = tomllib.loads(path.read_text(encoding="utf-8"))
        environment = raw["Environment"]
        packages = environment["Packages"]
        mode = environment.get("Mode", "shell")
    except (OSError, tomllib.TOMLDecodeError, KeyError, TypeError) as exc:
        die(f"invalid saved manifest for {label}: {exc}")
    if not isinstance(packages, list) or not packages or not all(isinstance(item, str) and PACKAGE.fullmatch(item) for item in packages):
        die(f"invalid saved manifest for {label}: Environment.Packages must be a non-empty list of official package names")
    if mode != "shell":
        die(f"saved manifest for {label} requires Environment.Mode = shell")
    return list(dict.fromkeys(packages))


def saved_snapshot_manifest(ident, version):
    return saved_snapshot_manifest_from_path(ROOT / ident / "manifests" / f"{version}.lumen", f"snapshot {version}")


def locked_repository(packages):
    temporary = tempfile.TemporaryDirectory(prefix="lumen-project-repo.", dir="/run")
    directory = Path(temporary.name)
    archives = validated_locked_archives(packages)
    for source in archives:
        destination = directory / source.name
        try:
            os.link(source, destination)
        except OSError as exc:
            # /var/lib and /run can be separate filesystems. The staged copy is
            # still disposable and leaves the verified local archive untouched.
            if exc.errno != errno.EXDEV:
                temporary.cleanup(); die(f"cannot stage locked archive: {source.name} ({exc})")
            shutil.copy2(source, destination)
    staged = [str(item) for item in sorted(directory.glob("*.pkg.tar.*")) if not item.name.endswith(".sig")]
    run(["repo-add", str(directory / "lumen-local.db.tar.gz"), *staged])
    os.link(directory / "lumen-local.db.tar.gz", directory / "lumen-local.db")
    return temporary, directory


def validated_locked_archives(packages):
    if not isinstance(packages, list) or not packages:
        die("project package lock is empty")
    archives = []
    seen = set()
    for package in packages:
        archive = package.get("archive") if isinstance(package, dict) else None
        checksum = package.get("sha256") if isinstance(package, dict) else None
        name = package.get("name") if isinstance(package, dict) else None
        if (not isinstance(name, str) or not PACKAGE.fullmatch(name)
                or not isinstance(archive, str)
                or not re.fullmatch(r"[A-Za-z0-9@._+:-]+\.pkg\.tar(?:\.[A-Za-z0-9]+)+", archive)
                or not isinstance(checksum, str) or not re.fullmatch(r"[0-9a-f]{64}", checksum)):
            die("project package lock contains an invalid archive")
        if archive in seen:
            die(f"project package lock contains a duplicate archive: {archive}")
        seen.add(archive)
        source = REPO / archive
        if not source.is_file() or source.is_symlink():
            die(f"locked archive is missing: {archive}")
        with source.open("rb") as handle:
            if hashlib.file_digest(handle, "sha256").hexdigest() != checksum:
                die(f"locked archive checksum changed: {archive}")
        archives.append(source)
    return sorted(archives, key=lambda item: item.name)


def validate_snapshot_archive(snapshot, version):
    result = run(["tar", "--zstd", "-tf", str(snapshot)], check=False,
                 stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    if result.returncode:
        die(f"snapshot archive is invalid: {version}")


def rehearse_snapshot(ident, record, version):
    if not re.fullmatch(r"v\d{6}", version):
        die("snapshot version must use the form v000001", 2)
    snapshot = ROOT / ident / "snapshots" / f"{version}.tar.zst"
    if not snapshot.is_file() or snapshot.is_symlink():
        die(f"snapshot not found: {version}")
    validate_snapshot_archive(snapshot, version)
    packages = load_version_lock(ident, version)
    manifest_packages = saved_snapshot_manifest(ident, version)
    temporary, directory = locked_repository(packages)
    try:
        command = [SHELL]
        for package in manifest_packages:
            command += ["--package", package]
        command += ["--repo-dir", str(directory), "--offline-only", "--prepare"]
        print(f"Offline snapshot rehearsal: {record['name']} ({version})")
        print("Checking the saved package closure only; project commands and files are not run.")
        result = run(command, check=False)
        if result.returncode:
            die(f"offline package closure could not bootstrap for {version}; inspect the local archive with `lumen repo verify`", result.returncode)
    finally:
        temporary.cleanup()
    print(f"Offline snapshot rehearsal: ready ({record['name']} {version})")


def safe_export_destination(value):
    destination = Path(value)
    if not destination.is_absolute() or ".." in destination.parts:
        die("export destination must be an absolute local directory without ..", 2)
    current = Path(destination.anchor)
    for part in destination.parts[1:-1]:
        current /= part
        if current.is_symlink():
            die("export destination may not pass through a symlink")
    parent = destination.parent
    if not parent.is_dir() or parent.is_symlink():
        die(f"export destination parent is not a real directory: {parent}")
    if os.path.lexists(destination):
        if destination.is_symlink():
            die("export destination may not be a symlink")
        if not destination.is_dir() or any(destination.iterdir()):
            die(f"export destination already exists and is not empty: {destination}")
        destination.rmdir()
    return destination


def sha256_file(path):
    with path.open("rb") as handle:
        return hashlib.file_digest(handle, "sha256").hexdigest()


def write_recovery_instructions(destination, record, version):
    (destination / "RECOVERY.md").write_text(
        "# Lumen offline snapshot recovery kit\n\n"
        f"Project: {record['name']}\nVersion: {version}\n\n"
        "This immutable local artifact contains one saved project snapshot, its saved "
        "manifest, exact package lock, locked local archives, and a generated local "
        "Pacman database. Verify SHA256SUMS before relying on it. It does not restore "
        "a workspace, register a project, execute project code, or replace separate backups.\n",
        encoding="utf-8",
    )


def write_checksum_manifest(destination):
    files = sorted(path for path in destination.rglob("*") if path.is_file() and path.name != "SHA256SUMS")
    lines = [f"{sha256_file(path)}  {path.relative_to(destination).as_posix()}" for path in files]
    (destination / "SHA256SUMS").write_text("\n".join(lines) + "\n", encoding="utf-8")


def export_snapshot(ident, record, version, destination_value):
    if not re.fullmatch(r"v\d{6}", version):
        die("snapshot version must use the form v000001", 2)
    snapshot = ROOT / ident / "snapshots" / f"{version}.tar.zst"
    if not snapshot.is_file() or snapshot.is_symlink():
        die(f"snapshot not found: {version}")
    validate_snapshot_archive(snapshot, version)
    manifest = ROOT / ident / "manifests" / f"{version}.lumen"
    manifest_packages = saved_snapshot_manifest(ident, version)
    packages = load_version_lock(ident, version)
    archives = validated_locked_archives(packages)
    destination = safe_export_destination(destination_value)
    sources = [snapshot, manifest, lock_path(ident, version), *archives]
    required = sum(path.stat().st_size for path in sources) + 64 * 1024 * 1024
    if shutil.disk_usage(destination.parent).free < required:
        die(f"insufficient free space for offline recovery kit at {destination.parent}")
    temporary = Path(tempfile.mkdtemp(prefix=".lumen-project-export.", dir=destination.parent))
    try:
        metadata = temporary / "metadata"
        archive_dir = temporary / "packages"
        metadata.mkdir()
        archive_dir.mkdir()
        shutil.copy2(snapshot, metadata / "snapshot.tar.zst")
        shutil.copy2(manifest, metadata / "project.lumen")
        shutil.copy2(lock_path(ident, version), metadata / "package-lock.json")
        for source in archives:
            shutil.copy2(source, archive_dir / source.name)
        copied_archives = [str(archive_dir / source.name) for source in archives]
        run(["repo-add", str(archive_dir / "lumen-local.db.tar.gz"), *copied_archives])
        os.link(archive_dir / "lumen-local.db.tar.gz", archive_dir / "lumen-local.db")
        write_recovery_instructions(temporary, record, version)
        write_checksum_manifest(temporary)
        os.replace(temporary, destination)
    except BaseException:
        shutil.rmtree(temporary, ignore_errors=True)
        raise
    total = sum(path.stat().st_size for path in destination.rglob("*") if path.is_file())
    print(f"Offline recovery kit exported: {destination}")
    print(f"Archives: {len(archives)}; bytes: {total}; checksums: {destination / 'SHA256SUMS'}")


def safe_kit_directory(value):
    directory = Path(value)
    if not directory.is_absolute() or ".." in directory.parts:
        die("recovery kit path must be an absolute local directory without ..", 2)
    current = Path(directory.anchor)
    for part in directory.parts[1:]:
        current /= part
        if current.is_symlink():
            die("recovery kit path may not pass through a symlink")
    if not directory.is_dir():
        die(f"recovery kit is not a directory: {directory}")
    return directory


def regular_kit_file(directory, relative):
    path = directory / relative
    if not path.is_file() or path.is_symlink():
        die(f"recovery kit payload is missing or unsafe: {relative}")
    return path


def checked_kit_relative(value):
    path = Path(value)
    if (not isinstance(value, str) or not value or path.is_absolute() or ".." in path.parts
            or path.as_posix() in (".", "") or any(part in ("", ".") for part in path.parts)):
        die("recovery kit checksum manifest contains an unsafe path")
    return path.as_posix()


def kit_checksum_entries(path):
    entries = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        die(f"cannot read recovery kit checksum manifest: {exc}")
    if not lines:
        die("recovery kit checksum manifest is empty")
    for line in lines:
        if not re.fullmatch(r"[0-9a-f]{64}  .+", line):
            die("recovery kit checksum manifest contains an invalid record")
        checksum, value = line.split("  ", 1)
        relative = checked_kit_relative(value)
        if relative in entries:
            die(f"recovery kit checksum manifest contains a duplicate path: {relative}")
        entries[relative] = checksum
    return entries


def load_kit_lock(path):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        packages = data.get("packages")
    except (OSError, json.JSONDecodeError) as exc:
        die(f"invalid recovery kit package lock: {exc}")
    if not isinstance(packages, list) or not packages:
        die("recovery kit package lock is empty")
    seen = set()
    result = []
    for package in packages:
        name = package.get("name") if isinstance(package, dict) else None
        version = package.get("version") if isinstance(package, dict) else None
        archive = package.get("archive") if isinstance(package, dict) else None
        checksum = package.get("sha256") if isinstance(package, dict) else None
        if (not isinstance(name, str) or not PACKAGE.fullmatch(name) or not isinstance(version, str) or not version
                or not isinstance(archive, str)
                or not re.fullmatch(r"[A-Za-z0-9@._+:-]+\.pkg\.tar(?:\.[A-Za-z0-9]+)+", archive)
                or not isinstance(checksum, str) or not re.fullmatch(r"[0-9a-f]{64}", checksum)):
            die("recovery kit package lock contains an invalid archive")
        if archive in seen:
            die(f"recovery kit package lock contains a duplicate archive: {archive}")
        seen.add(archive)
        result.append({"name": name, "version": version, "archive": archive, "sha256": checksum})
    return sorted(result, key=lambda item: item["archive"])


def package_metadata(path):
    result = run(["pacman", "-Qp", str(path)], check=False, capture_output=True)
    pieces = result.stdout.split()
    if result.returncode or len(pieces) < 2:
        die(f"recovery kit archive metadata is unreadable: {path.name}")
    return pieces[0], pieces[1]


def verify_kit_database(directory, packages):
    if not shutil.which("pacman"):
        die("recovery kit database cannot be checked: Pacman tooling is unavailable")
    with tempfile.TemporaryDirectory(prefix="lumen-kit-verify.") as temporary:
        temporary = Path(temporary)
        config = temporary / "pacman.conf"
        database = temporary / "db"
        cache = temporary / "cache"
        config.write_text(
            "[options]\nArchitecture = auto\nSigLevel = Never\n"
            f"DBPath = {database}\nCacheDir = {cache}\n\n"
            "[lumen-local]\nSigLevel = Optional TrustAll\n"
            f"Server = file://{directory / 'packages'}\n",
            encoding="utf-8",
        )
        refresh = run(["pacman", "--config", str(config), "--dbpath", str(database), "-Sy"],
                      check=False, capture_output=True)
        if refresh.returncode:
            die("recovery kit database cannot be refreshed from the local kit")
        for package in packages:
            result = run(["pacman", "--config", str(config), "--dbpath", str(database), "-Si", package["name"]],
                         check=False, capture_output=True)
            if result.returncode:
                die(f"recovery kit database does not provide locked package: {package['name']}")
            fields = {}
            for line in result.stdout.splitlines():
                if " : " in line:
                    key, value = line.split(" : ", 1)
                    fields[key.strip().lower()] = value.strip()
            if fields.get("name") != package["name"] or fields.get("version") != package["version"]:
                die(f"recovery kit database has a stale entry for: {package['archive']}")


def verify_recovery_kit(value):
    directory = safe_kit_directory(value)
    expected_fixed = {
        "RECOVERY.md", "SHA256SUMS", "metadata/snapshot.tar.zst", "metadata/project.lumen",
        "metadata/package-lock.json", "packages/lumen-local.db.tar.gz", "packages/lumen-local.db",
    }
    snapshot = regular_kit_file(directory, "metadata/snapshot.tar.zst")
    manifest = regular_kit_file(directory, "metadata/project.lumen")
    lock = regular_kit_file(directory, "metadata/package-lock.json")
    checksum_file = regular_kit_file(directory, "SHA256SUMS")
    for relative in ("RECOVERY.md", "packages/lumen-local.db.tar.gz", "packages/lumen-local.db"):
        regular_kit_file(directory, relative)
    packages = load_kit_lock(lock)
    expected = expected_fixed | {f"packages/{package['archive']}" for package in packages}
    actual = set()
    expected_directories = {"metadata", "packages"}
    actual_directories = set()
    for path in directory.rglob("*"):
        relative = path.relative_to(directory).as_posix()
        if path.is_symlink():
            die(f"recovery kit contains a symlink: {relative}")
        if path.is_dir():
            actual_directories.add(relative)
        elif path.is_file():
            actual.add(relative)
        else:
            die(f"recovery kit contains an unsafe entry: {relative}")
    if actual != expected or actual_directories != expected_directories:
        missing = sorted(expected - actual) or sorted(expected_directories - actual_directories)
        extra = sorted(actual - expected) or sorted(actual_directories - expected_directories)
        detail = f"missing {missing[0]}" if missing else f"unexpected {extra[0]}"
        die(f"recovery kit layout is incomplete or altered: {detail}")
    entries = kit_checksum_entries(checksum_file)
    if set(entries) != expected - {"SHA256SUMS"}:
        die("recovery kit checksum manifest does not cover exactly its payload")
    for relative, checksum in entries.items():
        payload = regular_kit_file(directory, relative)
        if sha256_file(payload) != checksum:
            die(f"recovery kit checksum changed: {relative}")
    validate_snapshot_archive(snapshot, "recovery kit snapshot")
    saved_snapshot_manifest_from_path(manifest, "recovery kit")
    for package in packages:
        archive = regular_kit_file(directory, f"packages/{package['archive']}")
        if sha256_file(archive) != package["sha256"]:
            die(f"recovery kit locked archive checksum changed: {package['archive']}")
        name, version = package_metadata(archive)
        if (name, version) != (package["name"], package["version"]):
            die(f"recovery kit archive metadata does not match lock: {package['archive']}")
    verify_kit_database(directory, packages)
    total = sum(path.stat().st_size for path in directory.rglob("*") if path.is_file())
    print(f"Offline recovery kit verified: {directory}")
    print(f"Archives: {len(packages)}; bytes: {total}; checksums: {checksum_file}")


def run_in_environment(cfg, command, packages=None):
    if not command:
        die("the requested command is empty in project.lumen")
    if cfg["mode"] == "host":
        if packages is not None:
            die("version-pinned runs require Environment.Mode = shell")
        return run(["/usr/bin/bash", "-lc", command], cwd=cfg["workspace"], check=False).returncode
    args = [SHELL]
    for package in cfg["packages"]:
        args += ["--package", package]
    args += ["--dir", str(cfg["workspace"]), "--command", command]
    if packages is None:
        return run(args, check=False).returncode
    temporary, directory = locked_repository(packages)
    try:
        return run(args + ["--repo-dir", str(directory), "--offline-only"], check=False).returncode
    finally:
        temporary.cleanup()


def next_version(ident):
    snapshots = ROOT / ident / "snapshots"
    numbers = [int(item.stem[1:]) for item in snapshots.glob("v*.tar.zst") if re.fullmatch(r"v\d{6}", item.stem)]
    return f"v{max(numbers, default=0) + 1:06d}"


def git_state(workspace):
    if not (workspace / ".git").exists():
        return None
    try:
        commit = subprocess.check_output(["git", "-C", str(workspace), "rev-parse", "HEAD"], text=True).strip()
        branch = subprocess.check_output(["git", "-C", str(workspace), "branch", "--show-current"], text=True).strip()
        dirty = bool(subprocess.check_output(["git", "-C", str(workspace), "status", "--porcelain"], text=True).strip())
        return {"commit": commit, "branch": branch, "dirty": dirty}
    except (OSError, subprocess.CalledProcessError):
        return None


def create_snapshot(ident, cfg, label=None, compile_before=None):
    prepare_lock(ident, cfg)
    if (cfg["compile_before"] if compile_before is None else compile_before) and cfg["compile"]:
        print("Compiling before snapshot…")
        if run_in_environment(cfg, cfg["compile"]) != 0:
            die("compile failed; snapshot was not created")
    version = next_version(ident)
    base = ROOT / ident
    temporary = base / "snapshots" / f".{version}.tar.zst"
    destination = base / "snapshots" / f"{version}.tar.zst"
    command = ["tar", "--zstd", "--numeric-owner"]
    for excluded in cfg["excludes"]:
        command.append(f"--exclude={excluded}")
    command += ["-cf", str(temporary), "-C", str(cfg["workspace"]), "."]
    run(command)
    os.replace(temporary, destination)
    shutil.copy2(cfg["config"], base / "manifests" / f"{version}.lumen")
    shutil.copy2(lock_path(ident), lock_path(ident, version))
    meta = {"version": version, "label": label or "", "created_at": __import__("datetime").datetime.now(__import__("datetime").timezone.utc).isoformat(), "git": git_state(cfg["workspace"])}
    atomic_json(base / "snapshots" / f"{version}.json", meta)
    print(f"Saved {cfg['name']} snapshot {version}.")
    return version


def versions(ident):
    result = []
    for metadata in sorted((ROOT / ident / "snapshots").glob("v*.json")):
        try:
            result.append(json.loads(metadata.read_text()))
        except json.JSONDecodeError:
            continue
    return result


def restore_snapshot(ident, cfg, version, yes):
    source = ROOT / ident / "snapshots" / f"{version}.tar.zst"
    if not source.is_file():
        die(f"snapshot not found: {version}")
    if not yes:
        die("restore changes the working tree; repeat with --yes")
    backup = create_snapshot(ident, cfg, label=f"automatic backup before restoring {version}", compile_before=False)
    with tempfile.TemporaryDirectory(prefix="lumen-project-restore.") as temporary:
        run(["tar", "--zstd", "-xf", str(source), "-C", temporary])
        run(["rsync", "-a", "--delete", f"{temporary}/", f"{cfg['workspace']}/"])
    print(f"Restored {version}; previous working tree saved as {backup}.")


def show_status(ident, record, cfg):
    current = lock_path(ident)
    print(f"Project: {record['name']} ({ident})")
    print(f"Path: {cfg['directory']}")
    print(f"Workspace: {cfg['workspace']}")
    print(f"Mode: {cfg['mode']}")
    print("Packages: " + ", ".join(cfg["packages"]))
    print(f"Snapshots: {len(versions(ident))}")
    print("Environment lock: " + ("ready" if current.exists() else "not prepared"))


def write_template(directory, name, description, uid, gid):
    path = config_path(directory)
    if path.exists():
        die(f"refusing to overwrite existing {path}")
    text = (
        "[Init]\n"
        f"Name = {json.dumps(name)}\nDescription = {json.dumps(description)}\n\n"
        "[Environment]\nPackages = [\"bash\"]\nWorkspace = \".\"\n"
        "Exec = \"\"\nCompile = \"\"\nMode = \"shell\"\n\n"
        "[Versions]\nPath = \".lumen/versions\"\nCompileBeforeSaving = true\n"
        "Exclude = [\".git\", \"target\", \"node_modules\", \".lumen\"]\n"
    )
    path.write_text(text, encoding="utf-8")
    os.chown(path, uid, gid)


def protected_archives():
    for lock in ROOT.glob("*/locks/v*.json"):
        try:
            for package in json.loads(lock.read_text()).get("packages", []):
                archive = package.get("archive")
                if isinstance(archive, str):
                    print(archive)
        except (OSError, json.JSONDecodeError):
            continue


def protected_archive_locks():
    """Print safe saved-lock archive ownership for read-only repo reporting."""
    associations = []
    for lock in sorted(ROOT.glob("*/locks/v*.json")):
        label = str(lock.relative_to(ROOT))
        try:
            packages = json.loads(lock.read_text(encoding="utf-8")).get("packages", [])
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(packages, list):
            continue
        for package in packages:
            archive = package.get("archive") if isinstance(package, dict) else None
            if isinstance(archive, str) and re.fullmatch(r"[A-Za-z0-9@._+:-]+\.pkg\.tar(?:\.[A-Za-z0-9]+)+", archive):
                associations.append((archive, label))
    for archive, label in sorted(set(associations)):
        print(f"{archive}\t{label}")


def protected_packages():
    packages = set()
    for lock in ROOT.glob("*/locks/v*.json"):
        try:
            packages.update(item["name"] for item in json.loads(lock.read_text()).get("packages", []) if isinstance(item.get("name"), str))
        except (OSError, json.JSONDecodeError):
            continue
    print("\n".join(sorted(packages)))


def verify_saved_locks():
    """Read every saved lock without changing archives, locks, or project state."""
    failures = []
    checked = 0
    for lock in sorted(ROOT.glob("*/locks/v*.json")):
        checked += 1
        label = str(lock.relative_to(ROOT))
        try:
            data = json.loads(lock.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            failures.append(f"{label}: invalid JSON ({exc})")
            continue
        packages = data.get("packages") if isinstance(data, dict) else None
        if not isinstance(packages, list):
            failures.append(f"{label}: packages must be a list")
            continue
        for position, package in sorted(enumerate(packages, start=1), key=lambda item: str(item[1].get("name", "")) if isinstance(item[1], dict) else ""):
            prefix = f"{label}: package #{position}"
            if not isinstance(package, dict):
                failures.append(f"{prefix}: entry must be an object")
                continue
            archive = package.get("archive")
            checksum = package.get("sha256")
            if not isinstance(archive, str) or not re.fullmatch(r"[A-Za-z0-9@._+:-]+\.pkg\.tar(?:\.[A-Za-z0-9]+)+", archive):
                failures.append(f"{prefix}: unsafe archive name {archive!r}")
                continue
            if not isinstance(checksum, str) or not re.fullmatch(r"[0-9a-f]{64}", checksum):
                failures.append(f"{prefix}: invalid SHA-256 for {archive}")
                continue
            source = REPO / archive
            try:
                if not source.is_file() or source.is_symlink():
                    failures.append(f"{prefix}: locked archive is missing: {archive}")
                    continue
                with source.open("rb") as handle:
                    actual = hashlib.file_digest(handle, "sha256").hexdigest()
            except OSError as exc:
                failures.append(f"{prefix}: cannot read {archive} ({exc})")
                continue
            if actual != checksum:
                failures.append(f"{prefix}: locked archive checksum changed: {archive}")
    print(f"Checked saved project locks: {checked}")
    if failures:
        print("Saved project locks are not reproducible:", file=sys.stderr)
        for failure in failures:
            print(f"- {failure}", file=sys.stderr)
        return 1
    print("Saved project locks: ready")
    return 0


def usage():
    print("""Usage: lumen project <command> [arguments]

Commands:
  init [directory] --name NAME --description TEXT
  list | status [project] | doctor [project] [--version v000001]
  prepare [project] | shell [project] | run [project] | compile [project]
  save [project] [--label TEXT] | versions [project]
  export [project] --version v000001 --to ABSOLUTE_DIRECTORY
  verify-kit ABSOLUTE_DIRECTORY
  restore [project] --version VERSION --yes
  diff [project] VERSION_A VERSION_B | remove PROJECT --yes

Compatibility form: lumen project PROJECT --run|--compile|--shell|--save|--list
""")


def main(arguments):
    if not arguments or arguments[0] in ("help", "--help", "-h"):
        usage(); return
    if arguments and arguments[0] == "verify-locks":
        raise SystemExit(verify_saved_locks())
    if arguments and arguments[0] == "protected-archives":
        protected_archives(); return
    if arguments and arguments[0] == "protected-archive-locks":
        protected_archive_locks(); return
    if arguments and arguments[0] == "protected-packages":
        protected_packages(); return
    if arguments and arguments[0] == "verify-kit":
        if len(arguments) != 2:
            die("usage: lumen project verify-kit ABSOLUTE_DIRECTORY", 2)
        verify_recovery_kit(arguments[1]); return
    require_root()
    if arguments and arguments[0] == "shell-config":
        if len(arguments) != 2:
            die("usage: lumen shell --dir DIRECTORY --config DIRECTORY/project.lumen", 2)
        ident, cfg = register(Path(arguments[1]))
        args = [SHELL]
        for package in cfg["packages"]: args += ["--package", package]
        args += ["--dir", str(cfg["workspace"])]
        raise SystemExit(run(args, check=False).returncode)
    command, rest = arguments[0], arguments[1:]
    if command == "init":
        directory = Path(".")
        if rest and not rest[0].startswith("--"):
            directory, rest = Path(rest[0]), rest[1:]
        if len(rest) != 4 or rest[0] != "--name" or rest[2] != "--description":
            die("usage: lumen project init [directory] --name NAME --description TEXT", 2)
        _, uid, gid = caller_ids()
        directory = directory.resolve()
        created = not directory.exists()
        directory.mkdir(parents=True, exist_ok=True)
        if created:
            os.chown(directory, uid, gid)
        if not os.access(directory, os.W_OK): die(f"directory is not writable: {directory}")
        write_template(directory, rest[1], rest[3], uid, gid)
        ident, _ = register(directory)
        print(f"Created project.lumen and registered {rest[1]} as {ident}.")
        return
    if command == "list":
        for ident, record in sorted(load_index()["projects"].items(), key=lambda item: item[1]["name"].lower()):
            print(f"{record['name']}\t{ident}\t{record['path']}")
        return
    if command == "remove":
        if len(rest) != 2 or rest[1] != "--yes": die("usage: lumen project remove PROJECT --yes", 2)
        ident, _, index = project_record(rest[0]); shutil.rmtree(ROOT / ident, ignore_errors=True); del index["projects"][ident]; atomic_json(INDEX, index)
        print(f"Removed Lumen metadata for {rest[0]}; project files were not touched."); return
    # Accept subcommands and the documented PROJECT --action compatibility form.
    actions = {"status", "doctor", "prepare", "shell", "run", "compile", "save", "versions", "export", "restore", "diff"}
    selector = None
    if command not in actions:
        selector, rest = command, rest
        if not rest or not rest[0].startswith("--"): die(f"unknown project command: {command}", 2)
        command, rest = rest[0][2:], rest[1:]
        if command == "list": command = "versions"
    if command not in actions: die(f"unknown project command: {command}", 2)
    if rest and not rest[0].startswith("--") and selector is None:
        selector, rest = rest[0], rest[1:]
    ident, record, _ = project_record(selector)
    if command == "doctor" and rest:
        if len(rest) != 2 or rest[0] != "--version":
            die("usage: lumen project doctor [project] --version v000001", 2)
        rehearse_snapshot(ident, record, rest[1]); return
    cfg = parse_config(Path(record["path"]))
    if command in ("status", "doctor"):
        show_status(ident, record, cfg); return
    if command == "prepare": prepare_lock(ident, cfg); print("Project environment prepared."); return
    if command == "shell":
        args = [SHELL]
        for package in cfg["packages"]: args += ["--package", package]
        args += ["--dir", str(cfg["workspace"])]
        raise SystemExit(run(args, check=False).returncode)
    if command in ("run", "compile"):
        version_packages = None
        if rest:
            if len(rest) != 2 or rest[0] != "--version": die(f"usage: lumen project {command} [project] [--version VERSION]", 2)
            version_packages = load_version_lock(ident, rest[1])
        else:
            prepare_lock(ident, cfg)
        raise SystemExit(run_in_environment(cfg, cfg["exec"] if command == "run" else cfg["compile"], version_packages))
    if command == "save":
        label = rest[1] if len(rest) == 2 and rest[0] == "--label" else ""
        if rest and not label: die("usage: lumen project save [project] [--label TEXT]", 2)
        create_snapshot(ident, cfg, label); return
    if command == "versions":
        for item in versions(ident): print(f"{item.get('version')}\t{item.get('created_at')}\t{item.get('label', '')}")
        return
    if command == "export":
        if len(rest) != 4 or rest[0] != "--version" or rest[2] != "--to":
            die("usage: lumen project export [project] --version v000001 --to ABSOLUTE_DIRECTORY", 2)
        export_snapshot(ident, record, rest[1], rest[3]); return
    if command == "restore":
        if len(rest) != 3 or rest[0] != "--version" or rest[2] != "--yes": die("usage: lumen project restore [project] --version VERSION --yes", 2)
        restore_snapshot(ident, cfg, rest[1], True); return
    if command == "diff":
        if len(rest) != 2: die("usage: lumen project diff [project] VERSION_A VERSION_B", 2)
        with tempfile.TemporaryDirectory(prefix="lumen-project-diff.") as temporary:
            left, right = Path(temporary) / "left", Path(temporary) / "right"; left.mkdir(); right.mkdir()
            for version, destination in zip(rest, (left, right)):
                source = ROOT / ident / "snapshots" / f"{version}.tar.zst"
                if not source.is_file(): die(f"snapshot not found: {version}")
                run(["tar", "--zstd", "-xf", str(source), "-C", str(destination)])
            raise SystemExit(run(["diff", "-ruN", str(left), str(right)], check=False).returncode)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except subprocess.CalledProcessError as exc:
        die(f"underlying command failed (exit {exc.returncode})", exc.returncode)
