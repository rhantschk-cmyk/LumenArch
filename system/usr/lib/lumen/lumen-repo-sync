#!/usr/bin/env bash
# Root helper for Lumen's local, offline-capable Pacman repository.
set -Eeuo pipefail

config_file=${LUMEN_REPO_CONFIG_FILE:-/etc/lumen/repo.conf}
exclude_file=${LUMEN_REPO_EXCLUDE_FILE:-/etc/lumen/repo-exclude}
holds_file=${LUMEN_REPO_HOLDS_FILE:-/etc/lumen/holds}
pacman_fragment=${LUMEN_PACMAN_FRAGMENT:-/etc/pacman.conf.d/lumen-local.conf}
pacman_config=${LUMEN_PACMAN_CONFIG:-/etc/pacman.conf}
holds_fragment=${LUMEN_HOLDS_FRAGMENT:-/etc/pacman.conf.d/lumen-holds.conf}
project_helper=${LUMEN_PROJECT_HELPER:-/usr/lib/lumen/lumen-project}

if [[ -r "$config_file" ]]; then
  source "$config_file"
else
  # Makes --help and status useful from an unpacked source tree as well.
  REPO_DIR=/var/lib/lumen/repo
  CACHE_DIR=/var/cache/pacman/pkg
  REPO_NAME=lumen-local
fi
repo_db="$REPO_DIR/$REPO_NAME.db.tar.gz"
retained_kits_dir=${LUMEN_REPO_RETAINED_KITS_DIR:-$REPO_DIR/.lumen-retained-kits}

usage() {
  cat <<'EOF'
Usage: lumen-repo-sync <command> [argument]

Commands:
  --from-cache, sync       mirror Pacman's local archive cache into Lumen
  add <package|archive>    add an archive, or download a named official package
  exclude <package>        keep a package out of the Lumen local repository
  unexclude <package>      allow a package into the local repository again
  hold <package>           prevent Pacman from updating a package
  unhold <package>         remove Lumen's update hold for a package
  status                   show repository, exclusion, and hold information
  verify                   audit local archive, database, source, and project-lock readiness
  verify-import DIR        prove a verified recovery kit's locked closure is retained locally
  retain-kit DIR --yes     retain a verified imported recovery-kit closure through future pruning
  reconcile --yes          rebuild only local database/source/sync metadata from valid archives
  import-kit --preview DIR compare a verified recovery kit with this local archive
  import-kit DIR --yes     import a verified kit's missing archives locally
  list                     list archives currently offered by the repository
  exclusions               list packages excluded from the local repository
  prune [--preview]        retain two cached versions of packages in the repo
EOF
}

require_root() {
  [[ $EUID -eq 0 ]] || { echo 'This command must run as root.' >&2; exit 1; }
}

valid_package_name() {
  [[ "$1" =~ ^[A-Za-z0-9@._+:-]+$ ]]
}

list_contains() {
  grep -Fxq -- "$1" "$2" 2>/dev/null
}

append_unique() {
  local value="$1" file="$2"
  list_contains "$value" "$file" || printf '%s\n' "$value" >> "$file"
}

remove_value() {
  local value="$1" file="$2" temporary
  temporary=$(mktemp "${file}.XXXXXX")
  grep -Fvx -- "$value" "$file" > "$temporary" || true
  install -m 0644 "$temporary" "$file"
  rm -f "$temporary"
}

package_name_from_archive() {
  pacman -Qp -q "$1"
}

local_sync_database() {
  local database_path
  database_path=$(pacman-conf DBPath 2>/dev/null || printf '/var/lib/pacman')
  printf '%s/sync/%s.db\n' "${database_path%/}" "$REPO_NAME"
}

write_holds_fragment() {
  local temporary
  temporary=$(mktemp)
  {
    printf '%s\n' '# Managed by Lumen. Do not edit while a Lumen command is running.'
    while IFS= read -r package; do
      [[ -n "$package" && "$package" != \#* ]] && printf 'IgnorePkg = %s\n' "$package"
    done < "$holds_file"
  } > "$temporary"
  install -Dm644 "$temporary" "$holds_fragment"
  rm -f "$temporary"
}

write_repo_fragment() {
  cat > "$pacman_fragment" <<EOF
# Managed by Lumen. Local archives are intentionally trusted because they are
# created from this machine's Pacman cache or explicitly added by an admin.
[$REPO_NAME]
SigLevel = Optional TrustAll
Server = file://$REPO_DIR
EOF
}

disable_pacman_source() {
  # pacman.conf permanently includes this fragment. Keep a valid empty file
  # when the local repository has no archives instead of deleting it.
  install -Dm644 /dev/null "$pacman_fragment"
}

ensure_pacman_source_is_included() {
  local include_line="Include = $pacman_fragment"
  grep -Fqx "$include_line" "$pacman_config" && return
  if grep -q '^LocalFileSigLevel = ' "$pacman_config"; then
    sed -i "/^LocalFileSigLevel = /a $include_line" "$pacman_config"
  elif grep -q '^\[options\]$' "$pacman_config"; then
    sed -i "/^\[options\]$/a $include_line" "$pacman_config"
  else
    echo 'Could not enable the Lumen local Pacman source: no [options] section.' >&2
    exit 1
  fi
}

sync_repository() {
  require_root
  command -v repo-add >/dev/null || { echo 'repo-add is unavailable; install pacman-contrib.' >&2; exit 1; }
  mkdir -p "$REPO_DIR"
  chmod 0755 "$REPO_DIR"
  local sync_database
  sync_database=$(local_sync_database)

  shopt -s nullglob
  local archive package
  for archive in "$CACHE_DIR"/*.pkg.tar.*; do
    [[ "$archive" == *.sig ]] && continue
    package=$(package_name_from_archive "$archive")
    list_contains "$package" "$exclude_file" && continue
    cp --reflink=auto --preserve=mode,timestamps -- "$archive" "$REPO_DIR/"
  done

  local -a included=()
  for archive in "$REPO_DIR"/*.pkg.tar.*; do
    [[ "$archive" == *.sig ]] && continue
    package=$(package_name_from_archive "$archive")
    if list_contains "$package" "$exclude_file"; then
      rm -f -- "$archive"
      continue
    fi
    included+=("$archive")
  done

  if ((${#included[@]} == 0)); then
    rm -f "$repo_db" "$REPO_DIR/$REPO_NAME.db" "$sync_database"
    disable_pacman_source
    echo 'Lumen local repository has no included archives; Pacman source disabled.'
    return
  fi

  rm -f "$repo_db" "$REPO_DIR/$REPO_NAME.db"
  repo-add "$repo_db" "${included[@]}"
  ln -f "$repo_db" "$REPO_DIR/$REPO_NAME.db"
  write_repo_fragment
  ensure_pacman_source_is_included
  # Pacman does not automatically refresh a file:// repository for every -S
  # request. Keeping its local sync database in step with repo-add prevents a
  # just-excluded archive from being selected from stale metadata.
  install -Dm644 "$REPO_DIR/$REPO_NAME.db" "$sync_database"
  echo "Lumen local repository updated: ${#included[@]} archive(s)."
}

add_archive_or_package() {
  require_root
  local input="$1"
  if [[ -f "$input" ]]; then
    mkdir -p "$REPO_DIR"
    cp --reflink=auto --preserve=mode,timestamps -- "$input" "$REPO_DIR/"
  else
    valid_package_name "$input" || { echo "Invalid package name: $input" >&2; exit 2; }
    pacman -Sw --noconfirm "$input"
  fi
  sync_repository
}

status() {
  local archive_count=0 excluded=0 held=0
  [[ -d "$REPO_DIR" ]] && archive_count=$(find "$REPO_DIR" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' | wc -l)
  [[ -f "$exclude_file" ]] && excluded=$(grep -Evc '^(#|$)' "$exclude_file" || true)
  [[ -f "$holds_file" ]] && held=$(grep -Evc '^(#|$)' "$holds_file" || true)
  printf 'Repository: %s\nArchives: %s\nExcluded: %s\nHeld updates: %s\n' "$REPO_DIR" "$archive_count" "$excluded" "$held"
  [[ -r "$pacman_fragment" ]] && grep -Fqx "[$REPO_NAME]" "$pacman_fragment" && echo 'Pacman source: enabled' || echo 'Pacman source: disabled until the first archive is synced'
}

list_archives() {
  if [[ ! -d "$REPO_DIR" ]]; then
    echo 'No local repository has been created yet.'
    return
  fi
  shopt -s nullglob
  local archive
  for archive in "$REPO_DIR"/*.pkg.tar.*; do
    [[ "$archive" == *.sig ]] && continue
    printf '%s\n' "$(package_name_from_archive "$archive")"
  done | LC_ALL=C sort -u
}

list_exclusions() {
  [[ -f "$exclude_file" ]] || return
  sed -E '/^(#|$)/d' "$exclude_file"
}

project_uses_package() {
  [[ -x "$project_helper" ]] || return 1
  "$project_helper" protected-packages 2>/dev/null | grep -Fxq -- "$1"
}

database_entries() {
  local database="$1" entry descriptor name version
  while IFS= read -r entry; do
    [[ "$entry" == */desc ]] || continue
    descriptor=$(tar -xOzf "$database" "$entry") || return 1
    name=$(printf '%s\n' "$descriptor" | sed -n '/^%NAME%$/ { n; p; q; }')
    version=$(printf '%s\n' "$descriptor" | sed -n '/^%VERSION%$/ { n; p; q; }')
    [[ -n "$name" && -n "$version" ]] || return 1
    printf '%s\t%s\n' "$name" "$version"
  done < <(tar -tzf "$database") | LC_ALL=C sort -u
}

verify_repository() {
  local -a archives=()
  local archive temporary expected_db actual_entries expected_entries sync_database sync_entries failures=0
  shopt -s nullglob
  for archive in "$REPO_DIR"/*.pkg.tar.*; do
    [[ "$archive" == *.sig ]] && continue
    archives+=("$archive")
  done

  if ((${#archives[@]} == 0)); then
    echo 'Local archive: empty (nothing to verify; seed it with `lumen repo sync` or `lumen repo add`).'
    "$project_helper" verify-locks
    return
  fi

  command -v pacman >/dev/null || { echo 'Local archive: Pacman metadata reader is unavailable; install Pacman tooling locally.' >&2; return 1; }
  command -v repo-add >/dev/null || { echo 'Local archive: repo-add is unavailable; install pacman-contrib locally.' >&2; return 1; }
  [[ -r "$pacman_fragment" ]] || { echo "Pacman source: missing fragment $pacman_fragment; run \`lumen repo reconcile --yes\`." >&2; failures=1; }
  if [[ -r "$pacman_fragment" ]] && ! grep -Fqx "[$REPO_NAME]" "$pacman_fragment"; then
    echo "Pacman source: $pacman_fragment does not enable [$REPO_NAME]; run \`lumen repo reconcile --yes\`." >&2
    failures=1
  fi
  if [[ -r "$pacman_fragment" ]] && ! grep -Fqx "Server = file://$REPO_DIR" "$pacman_fragment"; then
    echo "Pacman source: $pacman_fragment does not point to $REPO_DIR; run \`lumen repo reconcile --yes\`." >&2
    failures=1
  fi
  for archive in "${archives[@]}"; do
    if ! pacman -Qp -q "$archive" >/dev/null; then
      echo "Archive metadata: unreadable $archive; recreate this local archive." >&2
      failures=1
    fi
  done

  if [[ ! -r "$repo_db" ]]; then
    echo "Repository database: missing $repo_db; run \`lumen repo reconcile --yes\`." >&2
    failures=1
  else
    temporary=$(mktemp -d)
    expected_db="$temporary/$REPO_NAME.db.tar.gz"
    if ! repo-add "$expected_db" "${archives[@]}" >/dev/null; then
      echo 'Repository database: could not derive expected entries from local archives.' >&2
      failures=1
    elif ! actual_entries=$(database_entries "$repo_db"); then
      echo "Repository database: unreadable $repo_db; run \`lumen repo reconcile --yes\`." >&2
      failures=1
    elif ! expected_entries=$(database_entries "$expected_db"); then
      echo 'Repository database: generated expected database is unreadable.' >&2
      failures=1
    elif [[ "$actual_entries" != "$expected_entries" ]]; then
      echo "Repository database: entries are stale or incomplete; run \`lumen repo reconcile --yes\`." >&2
      failures=1
    fi
    rm -rf -- "$temporary"
  fi

  sync_database=$(local_sync_database)
  if [[ ! -r "$sync_database" ]]; then
    echo "Pacman sync database: missing $sync_database; run \`lumen repo reconcile --yes\`." >&2
    failures=1
  elif ! sync_entries=$(database_entries "$sync_database"); then
    echo "Pacman sync database: unreadable $sync_database; run \`lumen repo reconcile --yes\`." >&2
    failures=1
  elif [[ -n "${actual_entries:-}" && "$sync_entries" != "$actual_entries" ]]; then
    echo "Pacman sync database: entries are stale or incomplete; run \`lumen repo reconcile --yes\`." >&2
    failures=1
  fi
  if "$project_helper" verify-locks; then :; else failures=1; fi
  if ((failures)); then
    echo 'Local repository readiness: failed. Repair archives or run `lumen repo reconcile --yes`; no files were changed.' >&2
    return 1
  fi
  printf 'Local repository readiness: ready (%s archive(s), source/database and saved locks verified).\n' "${#archives[@]}"
}

pacman_source_can_be_included() {
  grep -Fqx "Include = $pacman_fragment" "$pacman_config" || grep -q '^LocalFileSigLevel = ' "$pacman_config" || grep -q '^\[options\]$' "$pacman_config"
}

reconcile_repository() {
  local archive package stage prospective_db source_stage sync_database sync_stage fragment_stage count=0
  local -a archives=()
  require_root
  [[ -d "$REPO_DIR" && ! -L "$REPO_DIR" ]] || { echo "Local repository reconciliation: not a real directory: $REPO_DIR" >&2; return 1; }
  command -v pacman >/dev/null || { echo 'Local repository reconciliation: Pacman metadata reader is unavailable locally.' >&2; return 1; }
  command -v repo-add >/dev/null || { echo 'Local repository reconciliation: repo-add is unavailable; install pacman-contrib locally.' >&2; return 1; }
  [[ -x "$project_helper" ]] || { echo 'Local repository reconciliation: Lumen project helper is unavailable locally.' >&2; return 1; }
  "$project_helper" verify-locks || return $?
  pacman_source_can_be_included || { echo "Local repository reconciliation: $pacman_config cannot include the Lumen local source." >&2; return 1; }

  shopt -s nullglob
  for archive in "$REPO_DIR"/*.pkg.tar.*; do
    [[ "$archive" == *.sig ]] && continue
    [[ -f "$archive" && ! -L "$archive" ]] || { echo "Local repository reconciliation: archive is unsafe or unreadable: $archive" >&2; return 1; }
    package=$(package_name_from_archive "$archive") || { echo "Local repository reconciliation: archive metadata is unreadable: $archive" >&2; return 1; }
    list_contains "$package" "$exclude_file" && { echo "Local repository reconciliation: archive is excluded by current policy: $archive" >&2; return 1; }
    archives+=("$archive")
  done
  count=${#archives[@]}
  stage=$(mktemp -d "$REPO_DIR/.lumen-reconcile.XXXXXX")
  source_stage="$stage/lumen-local.conf"
  sync_database=$(local_sync_database)

  if ((count)); then
    prospective_db="$stage/$REPO_NAME.db.tar.gz"
    repo-add "$prospective_db" "${archives[@]}" >/dev/null || { rm -rf -- "$stage"; echo 'Local repository reconciliation: could not generate local repository metadata.' >&2; return 1; }
    database_entries "$prospective_db" >/dev/null || { rm -rf -- "$stage"; echo 'Local repository reconciliation: generated local repository database is unreadable.' >&2; return 1; }
    cat > "$source_stage" <<EOF
# Managed by Lumen. Local archives are intentionally trusted because they are
# created from this machine's Pacman cache or explicitly added by an admin.
[$REPO_NAME]
SigLevel = Optional TrustAll
Server = file://$REPO_DIR
EOF
    sync_stage="$stage/$REPO_NAME.sync.db"
    install -m 0644 "$prospective_db" "$sync_stage"
  else
    : > "$source_stage"
  fi

  # Every derived file is ready before this first metadata publication boundary.
  ensure_pacman_source_is_included || { rm -rf -- "$stage"; return 1; }
  fragment_stage="${pacman_fragment}.lumen-reconcile.$$"
  install -Dm644 "$source_stage" "$fragment_stage"
  mv -f -- "$fragment_stage" "$pacman_fragment"
  if ((count)); then
    install -m 0644 "$prospective_db" "$REPO_DIR/.${REPO_NAME}.db.new"
    mv -f -- "$REPO_DIR/.${REPO_NAME}.db.new" "$repo_db"
    ln -f "$repo_db" "$REPO_DIR/$REPO_NAME.db"
    install -Dm644 "$sync_stage" "${sync_database}.lumen-reconcile.$$"
    mv -f -- "${sync_database}.lumen-reconcile.$$" "$sync_database"
    rm -rf -- "$stage"
    printf 'Local repository metadata reconciled: %s archive(s); local-first Pacman source enabled.\n' "$count"
  else
    rm -f -- "$repo_db" "$REPO_DIR/$REPO_NAME.db" "$sync_database"
    rm -rf -- "$stage"
    echo 'Local repository metadata reconciled: empty archive; local-first Pacman source disabled.'
  fi
}

adopted_retention_records() {
  # Emit package name, exact archive filename, checksum and lock-relative path.
  # A retained kit is state, not a hint: malformed records or changed payloads
  # stop pruning rather than allowing an offline closure to disappear.
  local record name archive checksum lock_path local_archive local_checksum
  [[ -e "$retained_kits_dir" || -L "$retained_kits_dir" ]] || return 0
  [[ -d "$retained_kits_dir" && ! -L "$retained_kits_dir" ]] || {
    echo "Retained recovery-kit state is not a real directory: $retained_kits_dir" >&2
    return 1
  }
  while IFS=$'\t' read -r name archive checksum lock_path; do
    [[ -n "$name" && -n "$archive" && -n "$checksum" && -n "$lock_path" ]] || continue
    local_archive="$REPO_DIR/$archive"
    [[ -f "$local_archive" && ! -L "$local_archive" ]] || {
      echo "Retained recovery-kit lock $lock_path requires an unsafe or missing archive: $archive" >&2
      return 1
    }
    local_checksum=$(sha256sum -- "$local_archive") || {
      echo "Retained recovery-kit lock $lock_path cannot hash archive: $archive" >&2
      return 1
    }
    [[ "${local_checksum%% *}" == "$checksum" ]] || {
      echo "Retained recovery-kit lock $lock_path no longer matches archive: $archive" >&2
      return 1
    }
    printf '%s\t%s\t%s\t%s\n' "$name" "$archive" "$checksum" "$lock_path"
  done < <(python3 - "$retained_kits_dir" <<'PY'
import json
import os
import re
import stat
import sys
from pathlib import Path

directory = Path(sys.argv[1])
mode = stat.S_IMODE(directory.stat().st_mode)
if directory.stat().st_uid != os.geteuid() or mode & 0o077:
    raise SystemExit("Retained recovery-kit state must be root-owned and mode 0700.")
for path in sorted(directory.iterdir(), key=lambda item: item.name):
    if path.is_symlink() or not path.is_file() or not re.fullmatch(r"[0-9a-f]{64}\.json", path.name):
        raise SystemExit(f"Retained recovery-kit state contains an unsafe entry: {path.name}")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f"Retained recovery-kit lock is unreadable: {path.name}: {exc}")
    required = {"schema", "kit_manifest_sha256", "project", "version", "packages"}
    if set(data) != required or data.get("schema") != 1 or not isinstance(data["project"], str) or not data["project"] or not isinstance(data["version"], str) or not re.fullmatch(r"v[0-9]{6}", data["version"]) or not isinstance(data["kit_manifest_sha256"], str) or not re.fullmatch(r"[0-9a-f]{64}", data["kit_manifest_sha256"]):
        raise SystemExit(f"Retained recovery-kit lock is malformed: {path.name}")
    packages = data["packages"]
    if not isinstance(packages, list) or not packages:
        raise SystemExit(f"Retained recovery-kit lock has no packages: {path.name}")
    previous = ""
    for package in packages:
        if not isinstance(package, dict) or set(package) != {"name", "archive", "sha256"}:
            raise SystemExit(f"Retained recovery-kit lock is malformed: {path.name}")
        name, archive, checksum = package["name"], package["archive"], package["sha256"]
        if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9@._+:-]+", name) or not isinstance(archive, str) or not re.fullmatch(r"[A-Za-z0-9@._+:-]+\.pkg\.tar(?:\.[A-Za-z0-9]+)+", archive) or not isinstance(checksum, str) or not re.fullmatch(r"[0-9a-f]{64}", checksum) or archive <= previous:
            raise SystemExit(f"Retained recovery-kit lock is malformed: {path.name}")
        previous = archive
        print(f"{name}\t{archive}\t{checksum}\tretained-kits/{path.name}")
PY
)
}

retained_protected_packages() {
  adopted_retention_records | cut -f1 | LC_ALL=C sort -u
}

retain_recovery_kit() {
  local kit="$1" stage candidate lock_file result name archive checksum local_archive local_checksum
  local -a records=()
  require_root
  [[ -x "$project_helper" ]] || { echo 'Recovery-kit retention: Lumen project helper is unavailable locally.' >&2; return 1; }
  # Keep the user-visible ordering explicit: source validation, target closure
  # validation, then one last source validation before state publication.
  "$project_helper" verify-kit "$kit" || return $?
  verify_imported_kit "$kit" || return $?
  "$project_helper" verify-kit "$kit" || return $?
  [[ -d "$REPO_DIR" && ! -L "$REPO_DIR" ]] || { echo "Recovery-kit retention: local repository is not a real directory: $REPO_DIR" >&2; return 1; }
  if [[ -e "$retained_kits_dir" || -L "$retained_kits_dir" ]]; then
    [[ -d "$retained_kits_dir" && ! -L "$retained_kits_dir" ]] || { echo "Recovery-kit retention: retained state is not a real directory: $retained_kits_dir" >&2; return 1; }
    [[ "$(stat -c '%u:%a' -- "$retained_kits_dir")" == "0:700" ]] || { echo "Recovery-kit retention: retained state must be root-owned and mode 0700: $retained_kits_dir" >&2; return 1; }
    adopted_retention_records >/dev/null || return $?
  else
    install -d -m 0700 "$retained_kits_dir"
  fi
  stage=$(mktemp -d "$retained_kits_dir/.lumen-retain.XXXXXX")
  trap 'rm -rf -- "$stage"' RETURN
  result=$(python3 - "$kit" "$stage/candidate.json" <<'PY'
import hashlib
import json
import re
import sys
from pathlib import Path

kit, output = map(Path, sys.argv[1:])
lock = json.loads((kit / "metadata/package-lock.json").read_text(encoding="utf-8"))
packages = lock.get("packages")
if not isinstance(packages, list) or not packages:
    raise SystemExit("Recovery-kit retention: verified kit lock is unexpectedly empty.")
recovery = (kit / "RECOVERY.md").read_text(encoding="utf-8")
project = re.search(r"^Project: (.+)$", recovery, re.M)
version = re.search(r"^Version: (v[0-9]{6})$", recovery, re.M)
if not project or not version:
    raise SystemExit("Recovery-kit retention: verified kit identity is incomplete.")
entries = []
for item in packages:
    if not isinstance(item, dict):
        raise SystemExit("Recovery-kit retention: verified kit lock is malformed.")
    name, archive, checksum = item.get("name"), item.get("archive"), item.get("sha256")
    if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9@._+:-]+", name) or not isinstance(archive, str) or not re.fullmatch(r"[A-Za-z0-9@._+:-]+\.pkg\.tar(?:\.[A-Za-z0-9]+)+", archive) or not isinstance(checksum, str) or not re.fullmatch(r"[0-9a-f]{64}", checksum):
        raise SystemExit("Recovery-kit retention: verified kit lock is malformed.")
    entries.append({"name": name, "archive": archive, "sha256": checksum})
entries.sort(key=lambda item: item["archive"])
if len({item["archive"] for item in entries}) != len(entries):
    raise SystemExit("Recovery-kit retention: verified kit lock repeats an archive.")
manifest = hashlib.file_digest((kit / "SHA256SUMS").open("rb"), "sha256").hexdigest()
data = {"schema": 1, "kit_manifest_sha256": manifest, "project": project.group(1), "version": version.group(1), "packages": entries}
output.write_text(json.dumps(data, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8")
print(manifest)
print(project.group(1))
print(version.group(1))
print(len(entries))
PY
) || return $?
  lock_file="${result%%$'\n'*}.json"
  while IFS=$'\t' read -r name archive checksum; do
    local_archive="$REPO_DIR/$archive"
    [[ -f "$local_archive" && ! -L "$local_archive" ]] || { echo "Recovery-kit retention: local archive disappeared or is unsafe: $archive" >&2; return 1; }
    local_checksum=$(sha256sum -- "$local_archive") || return 1
    [[ "${local_checksum%% *}" == "$checksum" ]] || { echo "Recovery-kit retention: local archive changed after verification: $archive" >&2; return 1; }
  done < <(python3 - "$stage/candidate.json" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8"))["packages"]:
    print(f'{item["name"]}\t{item["archive"]}\t{item["sha256"]}')
PY
)
  candidate="$retained_kits_dir/$lock_file"
  if [[ -e "$candidate" || -L "$candidate" ]]; then
    [[ -f "$candidate" && ! -L "$candidate" ]] || { echo "Recovery-kit retention: lock path is unsafe: $candidate" >&2; return 1; }
    cmp -s -- "$stage/candidate.json" "$candidate" || { echo "Recovery-kit retention: kit identity collides with different retention content: $candidate" >&2; return 1; }
    printf 'Recovery-kit retention: already retained; lock: %s.\n' "$candidate"
    return
  fi
  install -m 0600 "$stage/candidate.json" "$stage/$lock_file"
  mv -n -- "$stage/$lock_file" "$candidate" || true
  [[ -f "$candidate" ]] || { echo 'Recovery-kit retention: atomic lock publication failed.' >&2; return 1; }
  cmp -s -- "$stage/candidate.json" "$candidate" || { echo "Recovery-kit retention: kit identity collides with different retention content: $candidate" >&2; return 1; }
  printf 'Recovery-kit retention: adopted %s archive(s) for %s %s; lock: %s.\n' "$(printf '%s\n' "$result" | sed -n '4p')" "$(printf '%s\n' "$result" | sed -n '2p')" "$(printf '%s\n' "$result" | sed -n '3p')" "$candidate"
}

preview_prune() {
  local protected_csv output line total=0 lock_archive lock_path
  local -a protected=() candidates=() associations=() repo_archives=() retained_records=()
  shopt -s nullglob
  for line in "$REPO_DIR"/*.pkg.tar.*; do
    [[ "$line" == *.sig ]] || repo_archives+=("$line")
  done

  # Saved locks are the source of truth for exact offline reproducibility.
  # Abort instead of guessing if one names an unsafe, missing, or changed archive.
  if ! "$project_helper" verify-locks; then
    echo 'Archive cleanup preview: saved locks are not ready; run `lumen repo verify` before pruning.' >&2
    return 1
  fi
  if ((${#repo_archives[@]} == 0)); then
    echo 'Archive cleanup preview: local repository is empty.'
    return
  fi
  command -v paccache >/dev/null || { echo 'Archive cleanup preview: paccache is unavailable; install pacman-contrib locally.' >&2; return 1; }
  mapfile -t protected < <("$project_helper" protected-packages)
  adopted_retention_records >/dev/null || return $?
  mapfile -t retained_records < <(adopted_retention_records)
  if ((${#retained_records[@]})); then
    local retained_name
    while IFS=$'\t' read -r retained_name lock_archive _ lock_path; do
      protected+=("$retained_name")
      associations+=("$lock_archive"$'\t'"$lock_path")
    done < <(printf '%s\n' "${retained_records[@]}")
  fi
  mapfile -t protected < <(printf '%s\n' "${protected[@]}" | LC_ALL=C sort -u)
  if ((${#protected[@]})); then
    protected_csv=$(IFS=,; printf '%s' "${protected[*]}")
    output=$(paccache -dk2v --nocolor -c "$REPO_DIR" --ignore "$protected_csv") || {
      echo 'Archive cleanup preview: paccache could not calculate the local retention plan.' >&2
      return 1
    }
  else
    output=$(paccache -dk2v --nocolor -c "$REPO_DIR") || {
      echo 'Archive cleanup preview: paccache could not calculate the local retention plan.' >&2
      return 1
    }
  fi
  while IFS= read -r line; do
    [[ -f "$line" && ! -L "$line" && "$(dirname -- "$line")" == "$REPO_DIR" ]] || continue
    [[ "$line" == "$REPO_DIR"/*.pkg.tar.* && "$line" != *.sig ]] || continue
    candidates+=("$line")
    total=$((total + $(stat -c '%s' -- "$line")))
  done <<< "$output"
  local -a project_associations=()
  mapfile -t project_associations < <("$project_helper" protected-archive-locks)
  associations+=("${project_associations[@]}")

  echo 'Archive cleanup preview (read-only; normal prune retains two versions per package).'
  if ((${#candidates[@]})); then
    echo 'Removal candidates:'
    printf '%s\n' "${candidates[@]}" | LC_ALL=C sort | sed 's#^#- #'
  else
    echo 'Removal candidates: none'
  fi
  printf 'Reclaimable bytes: %s\n' "$total"
  if ((${#associations[@]})); then
    echo 'Saved snapshot- and retained-kit-protected archives:'
    for line in "${associations[@]}"; do
      lock_archive=${line%%$'\t'*}
      lock_path=${line#*$'\t'}
      printf -- '- %s required by %s\n' "$lock_archive" "$lock_path"
    done
  else
    echo 'Saved snapshot- and retained-kit-protected archives: none'
  fi
}

preview_import_kit() {
  local kit="$1" name archive checksum local_archive local_checksum total=0 failures=0
  local -a present=() candidates=() blockers=()
  [[ -x "$project_helper" ]] || {
    echo 'Recovery-kit import preview: Lumen project helper is unavailable locally.' >&2
    return 1
  }
  # Verify the removable artifact completely before comparing even one archive.
  "$project_helper" verify-kit "$kit" || return $?
  [[ -d "$REPO_DIR" && ! -L "$REPO_DIR" ]] || {
    echo "Recovery-kit import preview: local repository is not a real directory: $REPO_DIR" >&2
    return 1
  }
  command -v python3 >/dev/null || {
    echo 'Recovery-kit import preview: Python 3 is unavailable for safe lock parsing.' >&2
    return 1
  }

  while IFS=$'\t' read -r name archive checksum; do
    [[ -n "$name" && -n "$archive" && -n "$checksum" ]] || continue
    if list_contains "$name" "$exclude_file"; then
      blockers+=("packages/$archive (excluded by current local repository policy)")
      continue
    fi
    local_archive="$REPO_DIR/$archive"
    if [[ -e "$local_archive" || -L "$local_archive" ]]; then
      if [[ ! -f "$local_archive" || -L "$local_archive" ]]; then
        blockers+=("packages/$archive (local archive is unsafe or unreadable)")
        continue
      fi
      if ! local_checksum=$(sha256sum -- "$local_archive" 2>/dev/null); then
        blockers+=("packages/$archive (cannot hash local archive)")
        continue
      fi
      local_checksum=${local_checksum%% *}
      if [[ "$local_checksum" == "$checksum" ]]; then
        present+=("packages/$archive")
      else
        blockers+=("packages/$archive (same name has a different SHA-256 locally)")
      fi
    else
      candidates+=("$archive")
      total=$((total + $(stat -c '%s' -- "$kit/packages/$archive")))
    fi
  done < <(python3 - "$kit/metadata/package-lock.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    packages = json.load(handle)["packages"]
for package in sorted(packages, key=lambda item: item["archive"]):
    print(f'{package["name"]}\t{package["archive"]}\t{package["sha256"]}')
PY
)

  echo 'Recovery-kit archive import preview (read-only; no archives or databases are changed).'
  if ((${#present[@]})); then
    echo 'Already present (byte-identical):'
    printf '%s\n' "${present[@]}" | LC_ALL=C sort | sed 's#^#- #'
  else
    echo 'Already present (byte-identical): none'
  fi
  if ((${#candidates[@]})); then
    echo 'Would import:'
    printf '%s\n' "${candidates[@]}" | LC_ALL=C sort | sed 's#^#- packages/#'
  else
    echo 'Would import: none'
  fi
  printf 'Import bytes: %s\n' "$total"
  if ((${#blockers[@]})); then
    echo 'Blocked:' >&2
    printf '%s\n' "${blockers[@]}" | LC_ALL=C sort | sed 's#^#- #' >&2
    failures=1
  else
    echo 'Blocked: none'
  fi
  return "$failures"
}

verify_imported_kit() {
  local kit="$1" name archive checksum local_archive local_checksum target_archive failures=0 target_count=0 local_count=0
  local -a missing=() conflicts=()
  [[ -x "$project_helper" ]] || {
    echo 'Recovery-kit import completion verification: Lumen project helper is unavailable locally.' >&2
    return 1
  }
  # Validate the removable source completely before trusting its lock or
  # comparing any target archive. This command is intentionally read-only.
  "$project_helper" verify-kit "$kit" || return $?
  [[ -d "$REPO_DIR" && ! -L "$REPO_DIR" ]] || {
    echo "Recovery-kit import completion verification: local repository is not a real directory: $REPO_DIR" >&2
    return 1
  }
  command -v python3 >/dev/null || {
    echo 'Recovery-kit import completion verification: Python 3 is unavailable for safe lock parsing.' >&2
    return 1
  }
  verify_repository || return $?
  shopt -s nullglob
  for target_archive in "$REPO_DIR"/*.pkg.tar.*; do
    [[ "$target_archive" == *.sig ]] && continue
    local_count=$((local_count + 1))
  done

  while IFS=$'\t' read -r name archive checksum; do
    [[ -n "$name" && -n "$archive" && -n "$checksum" ]] || continue
    local_archive="$REPO_DIR/$archive"
    if [[ ! -e "$local_archive" && ! -L "$local_archive" ]]; then
      missing+=("packages/$archive")
      continue
    fi
    if [[ ! -f "$local_archive" || -L "$local_archive" ]]; then
      conflicts+=("packages/$archive (local archive is unsafe or unreadable)")
      continue
    fi
    if ! local_checksum=$(sha256sum -- "$local_archive" 2>/dev/null); then
      conflicts+=("packages/$archive (cannot hash local archive)")
      continue
    fi
    local_checksum=${local_checksum%% *}
    if [[ "$local_checksum" != "$checksum" ]]; then
      conflicts+=("packages/$archive (same name has a different SHA-256 locally)")
      continue
    fi
    target_count=$((target_count + 1))
  done < <(python3 - "$kit/metadata/package-lock.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    packages = json.load(handle)["packages"]
for package in sorted(packages, key=lambda item: item["archive"]):
    print(f'{package["name"]}\t{package["archive"]}\t{package["sha256"]}')
PY
)

  echo 'Recovery-kit import completion verification (read-only; no archives or metadata are changed).'
  if ((${#missing[@]})); then
    echo 'Missing from local archive:' >&2
    printf '%s\n' "${missing[@]}" | LC_ALL=C sort | sed 's#^#- #' >&2
    failures=1
  else
    echo 'Missing from local archive: none'
  fi
  if ((${#conflicts[@]})); then
    echo 'Checksum or safety conflicts:' >&2
    printf '%s\n' "${conflicts[@]}" | LC_ALL=C sort | sed 's#^#- #' >&2
    failures=1
  else
    echo 'Checksum or safety conflicts: none'
  fi
  if ((failures)); then
    echo 'Recovery-kit import completion: failed; no files were changed.' >&2
    return 1
  fi
  printf 'Recovery-kit import completion: ready; %s kit archive(s) are retained locally; target-only archives: %s.\n' "$target_count" "$((local_count - target_count))"
}

target_repository_ready_for_import() {
  local archive count=0
  [[ -d "$REPO_DIR" && ! -L "$REPO_DIR" ]] || {
    echo "Recovery-kit import: local repository is not a real directory: $REPO_DIR" >&2
    return 1
  }
  shopt -s nullglob
  for archive in "$REPO_DIR"/*.pkg.tar.*; do
    [[ "$archive" == *.sig ]] && continue
    [[ -f "$archive" && ! -L "$archive" ]] || {
      echo "Recovery-kit import: local archive is unsafe or unreadable: $archive" >&2
      return 1
    }
    count=$((count + 1))
  done
  ((count == 0)) && return 0
  verify_repository
}

import_recovery_kit() {
  local kit="$1" name archive checksum local_archive local_checksum staged_archive
  local stage prospective_db source_stage sync_database imported=0 present=0 total=0
  local -a candidates=() union_archives=()
  require_root
  [[ -x "$project_helper" ]] || { echo 'Recovery-kit import: Lumen project helper is unavailable locally.' >&2; return 1; }
  "$project_helper" verify-kit "$kit" || return $?
  target_repository_ready_for_import || return $?
  command -v python3 >/dev/null || { echo 'Recovery-kit import: Python 3 is unavailable for safe lock parsing.' >&2; return 1; }
  command -v repo-add >/dev/null || { echo 'Recovery-kit import: repo-add is unavailable; install pacman-contrib locally.' >&2; return 1; }
  command -v pacman >/dev/null || { echo 'Recovery-kit import: Pacman metadata reader is unavailable locally.' >&2; return 1; }
  grep -Fqx "Include = $pacman_fragment" "$pacman_config" || grep -q '^LocalFileSigLevel = ' "$pacman_config" || grep -q '^\[options\]$' "$pacman_config" || {
    echo "Recovery-kit import: $pacman_config cannot include the Lumen local source." >&2
    return 1
  }

  shopt -s nullglob
  for local_archive in "$REPO_DIR"/*.pkg.tar.*; do
    [[ "$local_archive" == *.sig ]] || union_archives+=("$local_archive")
  done
  while IFS=$'\t' read -r name archive checksum; do
    [[ -n "$name" && -n "$archive" && -n "$checksum" ]] || continue
    if list_contains "$name" "$exclude_file"; then
      echo "Recovery-kit import: packages/$archive is excluded by current local repository policy." >&2
      return 1
    fi
    local_archive="$REPO_DIR/$archive"
    if [[ -e "$local_archive" || -L "$local_archive" ]]; then
      [[ -f "$local_archive" && ! -L "$local_archive" ]] || { echo "Recovery-kit import: packages/$archive has an unsafe or unreadable local archive." >&2; return 1; }
      local_checksum=$(sha256sum -- "$local_archive")
      local_checksum=${local_checksum%% *}
      [[ "$local_checksum" == "$checksum" ]] || { echo "Recovery-kit import: packages/$archive has the same name but a different SHA-256 locally." >&2; return 1; }
      present=$((present + 1))
    else
      candidates+=("$archive"$'\t'"$checksum")
      total=$((total + $(stat -c '%s' -- "$kit/packages/$archive")))
    fi
  done < <(python3 - "$kit/metadata/package-lock.json" <<'PY'
import json
import sys
with open(sys.argv[1], encoding="utf-8") as handle:
    packages = json.load(handle)["packages"]
for package in sorted(packages, key=lambda item: item["archive"]):
    print(f'{package["name"]}\t{package["archive"]}\t{package["sha256"]}')
PY
)

  if ((${#candidates[@]} == 0)); then
    printf 'Recovery-kit import: nothing to import; %s archive(s) are already byte-identical.\n' "$present"
    return
  fi
  stage=$(mktemp -d "$REPO_DIR/.lumen-import.XXXXXX")
  for name in "${candidates[@]}"; do
    archive=${name%%$'\t'*}
    checksum=${name#*$'\t'}
    staged_archive="$stage/$archive"
    if ! cp --reflink=auto --preserve=mode,timestamps -- "$kit/packages/$archive" "$staged_archive"; then rm -rf -- "$stage"; return 1; fi
    local_checksum=$(sha256sum -- "$staged_archive") || { rm -rf -- "$stage"; return 1; }
    local_checksum=${local_checksum%% *}
    [[ "$local_checksum" == "$checksum" ]] || { rm -rf -- "$stage"; echo "Recovery-kit import: copied packages/$archive failed SHA-256 verification." >&2; return 1; }
    pacman -Qp -q "$staged_archive" >/dev/null || { rm -rf -- "$stage"; echo "Recovery-kit import: copied packages/$archive has unreadable package metadata." >&2; return 1; }
    union_archives+=("$staged_archive")
  done
  prospective_db="$stage/$REPO_NAME.db.tar.gz"
  repo-add "$prospective_db" "${union_archives[@]}" >/dev/null || { rm -rf -- "$stage"; echo 'Recovery-kit import: could not generate the future local repository database.' >&2; return 1; }
  database_entries "$prospective_db" >/dev/null || { rm -rf -- "$stage"; echo 'Recovery-kit import: generated local repository database is unreadable.' >&2; return 1; }
  source_stage="$stage/lumen-local.conf"
  cat > "$source_stage" <<EOF
# Managed by Lumen. Local archives are intentionally trusted because they are
# created from this machine's Pacman cache or explicitly added by an admin.
[$REPO_NAME]
SigLevel = Optional TrustAll
Server = file://$REPO_DIR
EOF
  sync_database=$(local_sync_database)
  for name in "${candidates[@]}"; do
    archive=${name%%$'\t'*}
    mv -- "$stage/$archive" "$REPO_DIR/$archive"
    imported=$((imported + 1))
  done
  install -Dm644 "$prospective_db" "$REPO_DIR/.${REPO_NAME}.db.new"
  mv -f -- "$REPO_DIR/.${REPO_NAME}.db.new" "$repo_db"
  ln -f "$repo_db" "$REPO_DIR/$REPO_NAME.db"
  install -Dm644 "$source_stage" "$pacman_fragment"
  ensure_pacman_source_is_included
  install -Dm644 "$REPO_DIR/$REPO_NAME.db" "$sync_database"
  rm -rf -- "$stage"
  printf 'Recovery-kit archives imported: %s; already present: %s; imported bytes: %s.\n' "$imported" "$present" "$total"
  printf 'Lumen local repository updated: %s archive(s); local-first Pacman source enabled.\n' "${#union_archives[@]}"
}

case "${1:-}" in
  --from-cache|sync) sync_repository ;;
  add) [[ $# -eq 2 ]] || { usage >&2; exit 2; }; add_archive_or_package "$2" ;;
  exclude|unexclude|hold|unhold)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    valid_package_name "$2" || { echo "Invalid package name: $2" >&2; exit 2; }
    require_root
    case "$1" in
      exclude)
        if project_uses_package "$2"; then
          echo "Refusing to exclude $2: one or more saved Lumen project versions require it." >&2
          echo 'Remove those snapshots first if you deliberately want to make them non-reproducible.' >&2
          exit 1
        fi
        append_unique "$2" "$exclude_file"; sync_repository
        ;;
      unexclude) remove_value "$2" "$exclude_file"; sync_repository ;;
      hold) append_unique "$2" "$holds_file"; write_holds_fragment ;;
      unhold) remove_value "$2" "$holds_file"; write_holds_fragment ;;
    esac
    ;;
  prune)
    if [[ "${2:-}" == --preview && $# -eq 2 ]]; then
      preview_prune
      exit $?
    fi
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    require_root
    mapfile -t protected < <([[ -x "$project_helper" ]] && "$project_helper" protected-packages || true)
    retained_protected_packages >/dev/null || exit $?
    mapfile -t retained < <(retained_protected_packages)
    protected+=("${retained[@]}")
    mapfile -t protected < <(printf '%s\n' "${protected[@]}" | LC_ALL=C sort -u)
    if ((${#protected[@]})); then
      protected_csv=$(IFS=,; printf '%s' "${protected[*]}")
      paccache -rk2 -c "$REPO_DIR" --ignore "$protected_csv"
    else
      paccache -rk2 -c "$REPO_DIR"
    fi
    sync_repository
    ;;
  import-kit)
    if [[ $# -eq 3 && "$2" == --preview ]]; then
      preview_import_kit "$3"
    elif [[ $# -eq 3 && "$3" == --yes ]]; then
      import_recovery_kit "$2"
    else
      usage >&2
      exit 2
    fi
    ;;
  verify-import)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    verify_imported_kit "$2"
    ;;
  retain-kit)
    [[ $# -eq 3 && "$3" == --yes ]] || { usage >&2; exit 2; }
    retain_recovery_kit "$2"
    ;;
  reconcile)
    [[ $# -eq 2 && "$2" == --yes ]] || { usage >&2; exit 2; }
    reconcile_repository
    ;;
  status) status ;;
  verify) verify_repository ;;
  list) list_archives ;;
  exclusions) list_exclusions ;;
  -h|--help|help|'') usage ;;
  *) echo "Unknown repository command: $1" >&2; usage >&2; exit 2 ;;
esac
